<% url = student_portal_url(token: assignment.access_token) %>
<tr id="<%= dom_id(assignment) %>">
  <td class="px-3 py-2">
    <% unless assignment.revoked? %>
      <%= check_box_tag "assignment_ids[]", assignment.id, false, form: "bulk-revoke" %>
    <% end %>
  </td>
  <td class="px-3 py-2 font-medium"><%= assignment.student.name %></td>
  <td class="px-3 py-2">
    <div class="flex items-center gap-2">
      <code class="max-w-xs truncate text-xs"><%= url %></code>
      <button type="button" data-controller="clipboard" data-clipboard-text-value="<%= url %>" data-clipboard-copied-value="<%= t("common.copied") %>" data-action="clipboard#copy" class="<%= btn_secondary %>"><%= t("common.copy") %></button>
    </div>
  </td>
  <td class="px-3 py-2"><%= assignment.revoked? ? t("statuses.revoked") : t("statuses.active") %></td>
  <td class="px-3 py-2"><%= assignment.attempts_used %>/<%= exam.max_attempts %></td>
  <td class="px-3 py-2 text-right">
    <div class="flex justify-end gap-2">
      <% unless assignment.revoked? %>
        <%= button_to t("exams.assign.revoke"), revoke_assignment_path(assignment), class: btn_secondary %>
      <% end %>
      <%= button_to t("exams.assign.regenerate"), regenerate_token_assignment_path(assignment), class: btn_secondary %>
    </div>
  </td>
</tr>
