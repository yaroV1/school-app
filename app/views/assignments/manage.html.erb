<% content_for :title, "Assign — #{@exam.title}" %>
<div class="mb-6">
  <%= link_to "← Back to test", test_path(@exam), class: "text-sm text-slate-600 underline" %>
  <h1 class="mt-2 text-2xl font-semibold">Assign: <%= @exam.title %></h1>
</div>

<% unless @exam.published? %>
  <p class="mb-4 rounded-md bg-amber-50 px-3 py-2 text-sm text-amber-800">Publish the test before students can start. You can still create links now.</p>
<% end %>

<section class="mb-8 rounded-lg border border-slate-200 bg-white p-4">
  <h2 class="mb-3 text-lg font-medium">Assign students</h2>
  <%= form_with url: test_assignments_path(@exam), class: "space-y-4" do %>
    <div>
      <label class="text-sm font-medium">Class (optional)</label>
      <%= select_tag :class_group_id, options_from_collection_for_select(@class_groups, :id, :name), include_blank: "Select a class", class: field_class %>
    </div>
    <div>
      <p class="mb-2 text-sm font-medium">Or pick students</p>
      <ul class="max-h-48 space-y-1 overflow-y-auto rounded border border-slate-200 p-3">
        <% @students.each do |student| %>
          <li>
            <label class="flex items-center gap-2 text-sm">
              <%= check_box_tag "student_ids[]", student.id %>
              <%= student.name %>
            </label>
          </li>
        <% end %>
      </ul>
    </div>
    <%= submit_tag "Create / restore links", class: btn_primary %>
  <% end %>
</section>

<section>
  <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
    <h2 class="text-lg font-medium">Access links</h2>
    <% if @exam.published? || @exam.closed? %>
      <%= link_to "Open live board", live_test_path(@exam), class: btn_primary %>
    <% end %>
  </div>

  <% if @assignments.any? %>
    <%= form_with url: bulk_revoke_test_assignments_path(@exam), method: :post do %>
      <div class="mb-3 flex flex-wrap gap-2">
        <%= submit_tag "Revoke selected", class: btn_secondary, data: { turbo_confirm: "Revoke selected links?" } %>
      </div>
      <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
        <table class="min-w-full text-sm">
          <thead class="bg-slate-50 text-left text-slate-600">
            <tr>
              <th class="px-3 py-2"></th>
              <th class="px-3 py-2">Student</th>
              <th class="px-3 py-2">Link</th>
              <th class="px-3 py-2">Status</th>
              <th class="px-3 py-2">Attempts</th>
              <th class="px-3 py-2"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @assignments.each do |assignment| %>
              <% url = student_portal_url(token: assignment.access_token) %>
              <tr>
                <td class="px-3 py-2">
                  <% unless assignment.revoked? %>
                    <%= check_box_tag "assignment_ids[]", assignment.id %>
                  <% end %>
                </td>
                <td class="px-3 py-2 font-medium"><%= assignment.student.name %></td>
                <td class="px-3 py-2">
                  <div class="flex items-center gap-2">
                    <code class="max-w-xs truncate text-xs"><%= url %></code>
                    <button type="button" data-controller="clipboard" data-clipboard-text-value="<%= url %>" data-action="clipboard#copy" class="<%= btn_secondary %>">Copy</button>
                  </div>
                </td>
                <td class="px-3 py-2"><%= assignment.revoked? ? "Revoked" : "Active" %></td>
                <td class="px-3 py-2"><%= assignment.attempts_used %>/<%= @exam.max_attempts %></td>
                <td class="px-3 py-2 text-right">
                  <div class="flex justify-end gap-2">
                    <% unless assignment.revoked? %>
                      <%= button_to "Revoke", revoke_assignment_path(assignment), class: btn_secondary %>
                    <% end %>
                    <%= button_to "Regenerate", regenerate_token_assignment_path(assignment), class: btn_secondary %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% else %>
    <p class="text-slate-600">No assignments yet.</p>
  <% end %>
</section>
