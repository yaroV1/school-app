<% content_for :title, t("exams.assign.title", title: @exam.title) %>
<%= render "exams/header", exam: @exam %>

<% unless @exam.published? %>
  <p class="mb-4 rounded-md bg-amber-50 px-3 py-2 text-sm text-amber-800"><%= t("exams.assign.publish_hint") %></p>
<% end %>

<section class="mb-8 rounded-lg border border-slate-200 bg-white p-4">
  <h2 class="mb-3 text-lg font-medium"><%= t("exams.assign.assign_students") %></h2>
  <% if @students.any? %>
    <%= form_with url: test_assignments_path(@exam), class: "mb-4" do %>
      <%= hidden_field_tag :assign_class, "1" %>
      <%= submit_tag t("exams.assign.assign_class"), class: btn_primary %>
    <% end %>
    <p class="mb-2 text-sm font-medium"><%= t("exams.assign.or_pick") %></p>
    <%= form_with url: test_assignments_path(@exam), class: "space-y-4" do %>
      <ul class="max-h-48 space-y-1 overflow-y-auto rounded border border-slate-200 p-3">
        <% @students.each do |student| %>
          <li>
            <label class="flex items-center gap-2 text-sm">
              <%= check_box_tag "student_ids[]", student.id %>
              <%= student.name %>
            </label>
          </li>
        <% end %>
      </ul>
      <%= submit_tag t("exams.assign.create_links"), class: btn_secondary %>
    <% end %>
  <% else %>
    <p class="text-slate-600"><%= t("exams.assign.empty_class") %></p>
    <%= link_to t("classes.show.add_student"), students_class_group_path(@exam.class_group), class: "mt-2 inline-block text-sm underline" %>
  <% end %>
</section>

<section>
  <h2 class="mb-3 text-lg font-medium"><%= t("exams.assign.access_links") %></h2>

  <% if @assignments.any? %>
    <%= form_with url: bulk_revoke_test_assignments_path(@exam), method: :post, id: "bulk-revoke", class: "mb-3" do %>
      <%= submit_tag t("exams.assign.revoke_selected"), class: btn_secondary, data: { turbo_confirm: t("exams.assign.revoke_confirm") } %>
    <% end %>
    <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
      <table class="min-w-full text-sm">
        <thead class="bg-slate-50 text-left text-slate-600">
          <tr>
            <th class="px-3 py-2"></th>
            <th class="px-3 py-2"><%= t("exams.assign.student") %></th>
            <th class="px-3 py-2"><%= t("exams.assign.link") %></th>
            <th class="px-3 py-2"><%= t("exams.assign.status") %></th>
            <th class="px-3 py-2"><%= t("exams.assign.attempts") %></th>
            <th class="px-3 py-2"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @assignments.each do |assignment| %>
            <%= render "assignments/row", assignment: assignment, exam: @exam %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-slate-600"><%= t("exams.assign.empty") %></p>
  <% end %>
</section>
