<% content_for :title, t("exams.assign.title", title: @exam.title) %>
<%= render "exams/header", exam: @exam %>

<% unless @exam.published? %>
  <p class="flash flash-warning"><%= t("exams.assign.publish_hint") %></p>
<% end %>

<section class="mb-8">
  <h2 class="section-title mb-3"><%= t("exams.assign.assign_students") %></h2>
  <% if @students.any? %>
    <%= form_with url: test_assignments_path(@exam), class: "mb-5" do %>
      <%= hidden_field_tag :assign_class, "1" %>
      <%= button_tag safe_join([ ui_icon("students"), t("exams.assign.assign_class") ]), class: btn_primary %>
    <% end %>
    <p class="field-label mb-2"><%= t("exams.assign.or_pick") %></p>
    <%= form_with url: test_assignments_path(@exam), class: "space-y-3" do %>
      <ul class="max-h-48 space-y-1 overflow-y-auto rounded-control border border-line p-2">
        <% @students.each do |student| %>
          <li>
            <label class="flex cursor-pointer items-center gap-2.5 rounded px-1.5 py-1 text-sm transition-colors hover:bg-surface-sunken">
              <%= check_box_tag "student_ids[]", student.id, false, class: "size-4 shrink-0 accent-accent" %>
              <%= student.name %>
            </label>
          </li>
        <% end %>
      </ul>
      <%= button_tag safe_join([ ui_icon("link"), t("exams.assign.create_links") ]), class: btn_secondary %>
    <% end %>
  <% else %>
    <p class="text-sm text-ink-muted"><%= t("exams.assign.empty_class") %></p>
    <%= link_to t("classes.show.add_student"), students_class_group_path(@exam.class_group), class: "link mt-2 inline-block text-sm" %>
  <% end %>
</section>

<section>
  <h2 class="section-title mb-3"><%= t("exams.assign.access_links") %></h2>

  <% if @assignments.any? %>
    <% telegram_available = TelegramBot.configured? && @exam.published? %>
    <p class="mb-3 text-sm text-ink-muted"><%= t(telegram_available ? "telegram.delivery.hint" : "telegram.delivery.unavailable") %></p>
    <% if telegram_available %>
      <div class="mb-3 flex flex-wrap items-center gap-3">
        <%= button_to t("telegram.delivery.send_all"), test_telegram_deliveries_path(@exam), params: { send_all: "1" }, class: btn_primary, data: { turbo_confirm: t("telegram.delivery.confirm") } %>
        <%= link_to t("telegram.delivery.refresh"), manage_test_assignments_path(@exam), class: "link text-sm" %>
      </div>
    <% end %>
    <%= form_with url: bulk_revoke_test_assignments_path(@exam), method: :post, authenticity_token: form_authenticity_token, id: "bulk-revoke", class: "mb-3 flex flex-wrap gap-2" do %>
      <% if telegram_available %>
        <%= button_tag t("telegram.delivery.send_selected"), formaction: test_telegram_deliveries_path(@exam), class: btn_secondary, data: { turbo_confirm: t("telegram.delivery.confirm") } %>
      <% end %>
      <%= button_tag safe_join([ ui_icon("ban"), t("exams.assign.revoke_selected") ]), class: btn_danger, data: { turbo_confirm: t("exams.assign.revoke_confirm") } %>
    <% end %>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th class="w-8"></th>
            <th><%= t("exams.assign.student") %></th>
            <th><%= t("exams.assign.link") %></th>
            <th><%= t("exams.assign.status") %></th>
            <th><%= t("exams.assign.attempts") %></th>
            <th><%= t("telegram.title") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @assignments.each do |assignment| %>
            <%= render "assignments/row", assignment: assignment, exam: @exam %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="empty-state"><%= t("exams.assign.empty") %></p>
  <% end %>
</section>
