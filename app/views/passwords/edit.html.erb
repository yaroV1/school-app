<% content_for :title, t("auth.passwords.update_title") %>
<div class="mx-auto w-full max-w-sm">
  <h1 class="page-title mb-6 text-center"><%= t("auth.passwords.update_title") %></h1>

  <%= form_with url: password_path(params[:token]), method: :put, class: "card card-pad space-y-4" do |form| %>
    <div class="fieldset">
      <%= form.label :password, t("auth.passwords.new_placeholder"), class: "field-label" %>
      <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", maxlength: 72, class: field_class %>
    </div>

    <div class="fieldset">
      <%= form.label :password_confirmation, t("auth.passwords.confirm_placeholder"), class: "field-label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: field_class %>
    </div>

    <%= form.submit t("common.save"), class: "#{btn_primary} w-full" %>
  <% end %>
</div>
