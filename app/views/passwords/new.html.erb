<% content_for :title, t("auth.passwords.forgot_title") %>
<div class="mx-auto w-full max-w-sm">
  <h1 class="page-title mb-6 text-center"><%= t("auth.passwords.forgot_title") %></h1>

  <%= form_with url: passwords_path, class: "card card-pad space-y-4" do |form| %>
    <div class="fieldset">
      <%= form.label :email_address, t("auth.email"), class: "field-label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: t("auth.passwords.email_placeholder"), value: params[:email_address], class: field_class %>
    </div>

    <%= form.submit t("auth.passwords.send_instructions"), class: "#{btn_primary} w-full" %>
    <p class="text-center">
      <%= link_to t("auth.sign_in"), new_session_path, class: "link text-sm" %>
    </p>
  <% end %>
</div>
