<!DOCTYPE html>
<html lang="uk">
  <head>
    <title><%= content_for(:title) || t("app_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <% if authenticated? %>
      <header class="border-b border-slate-200 bg-white">
        <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3">
          <nav class="flex items-center gap-4 text-sm font-medium">
            <%= link_to t("app_name"), class_groups_path, class: "text-slate-900" %>
            <%= link_to t("nav.classes"), class_groups_path, class: nav_class(class_groups_path) %>
          </nav>
          <div class="flex items-center gap-3 text-sm text-slate-600">
            <span><%= Current.user.email_address %></span>
            <%= button_to t("nav.sign_out"), session_path, method: :delete, class: "rounded-md border border-slate-300 px-2 py-1 hover:bg-slate-100" %>
          </div>
        </div>
      </header>
    <% end %>

    <main class="mx-auto max-w-5xl px-4 py-8">
      <% if notice = flash[:notice] %>
        <p class="mb-4 rounded-md bg-emerald-50 px-3 py-2 text-sm text-emerald-700" id="notice"><%= notice %></p>
      <% end %>
      <% if alert = flash[:alert] %>
        <p class="mb-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700" id="alert"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
