<% content_for :title, @class_group.name %>
<%= render "class_groups/header", class_group: @class_group %>

<section>
  <% if @subjects.any? %>
    <ul class="mb-4 divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
      <% @subjects.each do |subject| %>
        <li class="flex items-center justify-between gap-3 px-4 py-3">
          <div>
            <%= link_to subject.name, subject_path(subject), class: "font-medium hover:underline" %>
            <span class="text-sm text-slate-500"> · <%= t("classes.tests_count", count: subject.exams.size) %></span>
          </div>
          <%= link_to t("common.open"), subject_path(subject), class: btn_secondary %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mb-4 text-slate-600"><%= t("classes.show.empty_subjects") %></p>
  <% end %>

  <div class="rounded-lg border border-slate-200 bg-white p-4">
    <h3 class="mb-3 text-sm font-medium"><%= t("classes.show.add_subject") %></h3>
    <%= form_with model: @subject, url: class_group_subjects_path(@class_group), class: "flex flex-wrap items-end gap-3" do |f| %>
      <% if @subject.errors.any? %>
        <div class="w-full rounded-md bg-red-50 px-3 py-2 text-sm text-red-700"><%= @subject.errors.full_messages.to_sentence %></div>
      <% end %>
      <div class="min-w-56 flex-1">
        <%= f.label :name, class: "text-sm font-medium" %>
        <%= f.text_field :name, required: true, class: field_class %>
      </div>
      <%= f.submit t("classes.show.add_subject"), class: btn_primary %>
    <% end %>
  </div>
</section>
