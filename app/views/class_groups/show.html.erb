<% content_for :title, @class_group.name %>
<div class="mb-6">
  <%= link_to t("classes.show.back"), class_groups_path, class: "text-sm text-slate-600 underline" %>
  <div class="mt-2 flex items-start justify-between gap-4">
    <h1 class="text-2xl font-semibold"><%= @class_group.name %></h1>
    <div class="flex gap-2">
      <%= link_to t("common.edit"), edit_class_group_path(@class_group), class: btn_secondary %>
      <%= button_to t("common.delete"), class_group_path(@class_group), method: :delete, form: { data: { turbo_confirm: t("classes.show.delete_confirm") } }, class: btn_secondary %>
    </div>
  </div>
</div>

<section class="mb-10">
  <div class="mb-3 flex items-center justify-between gap-3">
    <h2 class="text-lg font-medium"><%= t("classes.show.students") %></h2>
  </div>

  <% if @students.any? %>
    <ul class="mb-4 divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
      <% @students.each do |student| %>
        <li class="flex items-center justify-between gap-3 px-4 py-3">
          <div>
            <%= link_to student.name, student_path(student), class: "font-medium hover:underline" %>
            <% if student.email.present? %><span class="text-sm text-slate-500"> · <%= student.email %></span><% end %>
          </div>
          <div class="flex gap-2">
            <%= link_to t("common.edit"), edit_student_path(student), class: btn_secondary %>
            <%= button_to t("classes.show.remove_member"), remove_member_class_group_path(@class_group, student_id: student.id), method: :delete, form: { data: { turbo_confirm: t("classes.show.remove_member_confirm") } }, class: "text-sm text-red-600 underline" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mb-4 text-slate-600"><%= t("classes.show.empty_students") %></p>
  <% end %>

  <div class="rounded-lg border border-slate-200 bg-white p-4">
    <h3 class="mb-3 text-sm font-medium"><%= t("classes.show.add_student") %></h3>
    <%= form_with model: @student, url: class_group_students_path(@class_group), class: "grid gap-3 sm:grid-cols-2" do |f| %>
      <% if @student.errors.any? %>
        <div class="sm:col-span-2 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700"><%= @student.errors.full_messages.to_sentence %></div>
      <% end %>
      <div>
        <%= f.label :name, class: "text-sm font-medium" %>
        <%= f.text_field :name, required: true, class: field_class %>
      </div>
      <div>
        <%= f.label :email, t("students.form.email_optional"), class: "text-sm font-medium" %>
        <%= f.email_field :email, class: field_class %>
      </div>
      <div class="sm:col-span-2">
        <%= f.submit t("classes.show.add_student"), class: btn_primary %>
      </div>
    <% end %>
  </div>
</section>

<section>
  <div class="mb-3 flex items-center justify-between gap-3">
    <h2 class="text-lg font-medium"><%= t("classes.show.subjects") %></h2>
  </div>

  <% if @subjects.any? %>
    <ul class="mb-4 divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
      <% @subjects.each do |subject| %>
        <li class="flex items-center justify-between gap-3 px-4 py-3">
          <div>
            <%= link_to subject.name, subject_path(subject), class: "font-medium hover:underline" %>
            <span class="text-sm text-slate-500"> · <%= t("classes.tests_count", count: subject.exams.size) %></span>
          </div>
          <%= link_to t("common.open"), subject_path(subject), class: btn_secondary %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mb-4 text-slate-600"><%= t("classes.show.empty_subjects") %></p>
  <% end %>

  <div class="rounded-lg border border-slate-200 bg-white p-4">
    <h3 class="mb-3 text-sm font-medium"><%= t("classes.show.add_subject") %></h3>
    <%= form_with model: @subject, url: class_group_subjects_path(@class_group), class: "flex flex-wrap items-end gap-3" do |f| %>
      <% if @subject.errors.any? %>
        <div class="w-full rounded-md bg-red-50 px-3 py-2 text-sm text-red-700"><%= @subject.errors.full_messages.to_sentence %></div>
      <% end %>
      <div class="min-w-56 flex-1">
        <%= f.label :name, class: "text-sm font-medium" %>
        <%= f.text_field :name, required: true, class: field_class %>
      </div>
      <%= f.submit t("classes.show.add_subject"), class: btn_primary %>
    <% end %>
  </div>
</section>
