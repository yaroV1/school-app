<% content_for :title, @class_group.name %>
<%= render "class_groups/header", class_group: @class_group %>

<section class="space-y-4">
  <% if @subjects.any? %>
    <ul class="list">
      <% @subjects.each do |subject| %>
        <li class="list-row">
          <div>
            <%= link_to subject.name, subject_path(subject), class: "list-row-title" %>
            <div class="list-row-meta">
              <span><%= t("classes.tests_count", count: subject.exams.size) %></span>
            </div>
          </div>
          <%= link_to t("common.open"), subject_path(subject), class: "#{btn_secondary} btn-sm" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <%= render "shared/empty_state", icon: "subjects", message: t("classes.show.empty_subjects") %>
  <% end %>

  <div class="card card-pad">
    <h2 class="card-title mb-3"><%= t("classes.show.add_subject") %></h2>
    <%= form_with model: @subject, url: class_group_subjects_path(@class_group), class: "flex flex-wrap items-end gap-3" do |f| %>
      <%= render "shared/form_errors", record: @subject, span: "w-full" %>
      <div class="min-w-56 flex-1">
        <%= f.label :name, class: "field-label" %>
        <%= f.text_field :name, required: true, class: field_class %>
      </div>
      <%= f.submit t("classes.show.add_subject"), class: btn_primary %>
    <% end %>
  </div>
</section>
