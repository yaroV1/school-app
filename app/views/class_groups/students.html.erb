<% content_for :title, @class_group.name %>
<%= render "class_groups/header", class_group: @class_group %>

<section class="space-y-4">
  <% if @students.any? %>
    <ul class="list max-h-96 overflow-y-auto">
      <% @students.each do |student| %>
        <li class="list-row">
          <div>
            <%= link_to student.name, student_path(student), class: "list-row-title" %>
            <% if student.email.present? %>
              <div class="list-row-meta"><span><%= student.email %></span></div>
            <% end %>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <%= link_to t("common.edit"), edit_student_path(student), class: "#{btn_secondary} btn-sm" %>
            <%= button_to t("classes.show.remove_member"), remove_member_class_group_path(@class_group, student_id: student.id), method: :delete, form: { data: { turbo_confirm: t("classes.show.remove_member_confirm") } }, class: "#{btn_danger} btn-sm" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <%= render "shared/empty_state", icon: "students", message: t("classes.show.empty_students") %>
  <% end %>

  <div class="card card-pad">
    <h2 class="card-title mb-3"><%= t("classes.show.add_student") %></h2>
    <%= form_with model: @student, url: class_group_students_path(@class_group), class: "grid gap-3 sm:grid-cols-2" do |f| %>
      <%= render "shared/form_errors", record: @student, span: "sm:col-span-2" %>
      <div>
        <%= f.label :name, class: "field-label" %>
        <%= f.text_field :name, required: true, class: field_class %>
      </div>
      <div>
        <%= f.label :email, t("students.form.email_optional"), class: "field-label" %>
        <%= f.email_field :email, class: field_class %>
      </div>
      <div class="sm:col-span-2">
        <%= f.submit t("classes.show.add_student"), class: btn_primary %>
      </div>
    <% end %>
  </div>
</section>
