<%= form_with model: class_group, class: "card card-pad max-w-md space-y-4" do |f| %>
  <%= render "shared/form_errors", record: class_group %>
  <div class="fieldset">
    <%= f.label :name, class: "field-label" %>
    <%= f.text_field :name, required: true, class: field_class %>
  </div>
  <%= f.submit class: btn_primary %>
<% end %>
