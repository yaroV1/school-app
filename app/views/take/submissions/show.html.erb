<% content_for :title, t("take.done_title") %>
<div class="space-y-6">
  <div class="card card-pad mx-auto max-w-md space-y-3 text-center">
    <span class="mx-auto flex size-11 items-center justify-center rounded-chip bg-success-soft text-success">
      <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m5 12.5 4.5 4.5L19 7.5" />
      </svg>
    </span>
    <h1 class="page-title"><%= t("take.done_heading") %></h1>
    <p class="text-sm text-ink-muted"><%= t("take.done_body", name: @student.name, title: @exam.title) %></p>
    <% if @latest %>
      <p class="text-sm">
        <%= t("take.done_attempt", n: @latest.attempt_no) %>
        <span class="text-ink-subtle" aria-hidden="true">·</span>
        <%= status_badge(@latest.status) %>
        <% if @latest.submitted_at %>
          <span class="text-ink-subtle" aria-hidden="true">·</span>
          <span class="text-ink-muted"><%= l(@latest.submitted_at, format: :short) %></span>
        <% end %>
      </p>
    <% end %>
    <p class="text-sm text-ink-muted"><%= t("take.close_window") %></p>
  </div>

  <% if @results_visible %>
    <article id="student_result" class="mx-auto max-w-3xl space-y-5">
      <header class="card card-pad">
        <p class="text-sm text-ink-muted"><%= t("take.results.heading") %></p>
        <h2 class="page-title mt-1"><%= @exam.title %></h2>
        <p class="mt-3 text-base font-semibold text-ink">
          <%= t("take.results.total") %>:
          <span class="num"><%= t("attempts.report.earned", score: score_text(@grade.total_score), max: score_text(@grade.max_score)) %></span>
        </p>
      </header>

      <ol class="space-y-4">
        <% @questions.each_with_index do |question, index| %>
          <% answer = @answers[question.id] %>
          <li id="<%= dom_id(question, :result) %>" class="card card-pad">
            <div class="flex flex-wrap items-center gap-2 text-xs text-ink-muted">
              <span class="num font-semibold">№<%= index + 1 %></span>
              <span class="chip"><%= t("question_types.#{question.question_type}") %></span>
              <span class="num"><%= t("attempts.report.earned", score: score_text(answer&.effective_score), max: score_text(question.points)) %></span>
            </div>

            <%= render "questions/photo", question: question %>
            <% if question.source? && question.source_text.present? %>
              <div class="mt-3">
                <p class="mb-1.5 text-xs font-medium text-ink-muted"><%= t("take.source.label") %></p>
                <div class="source-text"><%= question.source_text %></div>
              </div>
            <% end %>
            <p class="mt-3 font-medium whitespace-pre-wrap text-ink"><%= question.prompt %></p>

            <%= render "shared/student_answer", question: question, answer: answer %>
            <%= render "take/submissions/correct_answer", question: question if question.auto_gradable? %>

            <% if answer&.teacher_comment.present? %>
              <p class="mt-3 text-xs font-medium text-ink-muted"><%= t("attempts.report.teacher_comment") %></p>
              <p class="mt-1 text-sm whitespace-pre-wrap text-ink"><%= answer.teacher_comment %></p>
            <% end %>
          </li>
        <% end %>
      </ol>

      <% if @grade.teacher_comment.present? %>
        <section class="card card-pad">
          <p class="text-xs font-medium text-ink-muted"><%= t("attempts.grade.overall_comment") %></p>
          <p class="mt-1 text-sm whitespace-pre-wrap text-ink"><%= @grade.teacher_comment %></p>
        </section>
      <% end %>
    </article>
  <% end %>
</div>
