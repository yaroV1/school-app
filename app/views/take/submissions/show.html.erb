<% content_for :title, t("take.done_title") %>
<div class="space-y-4 text-center">
  <h1 class="text-2xl font-semibold"><%= t("take.done_heading") %></h1>
  <p class="text-slate-600"><%= t("take.done_body", name: @student.name, title: @exam.title) %></p>
  <% if @latest %>
    <p class="text-sm text-slate-500">
      <%= t("take.done_attempt", n: @latest.attempt_no) %> · <%= t("statuses.#{@latest.status}") %>
      <% if @latest.submitted_at %> · <%= l(@latest.submitted_at, format: :short) %><% end %>
    </p>
  <% end %>
  <p class="text-sm text-slate-500"><%= t("take.close_window") %></p>
</div>
