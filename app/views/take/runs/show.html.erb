<% content_for :title, @exam.title %>
<% server_now = Time.current %>

<div class="mb-5">
  <p class="text-sm text-ink-muted"><%= @exam.subject.name %></p>
  <h1 class="page-title mt-0.5"><%= @exam.title %></h1>
</div>

<%= form_with url: student_submit_path(token: @assignment.access_token), method: :post,
      data: {
        controller: "autosave focus-guard run-progress",
        focus_guard_url_value: student_focus_events_path(token: @assignment.access_token),
        focus_guard_attempt_id_value: @attempt.id,
        autosave_url_value: student_answers_path(token: @assignment.access_token),
        autosave_attempt_id_value: @attempt.id,
        autosave_interval_value: 5000,
        autosave_saving_value: t("take.saving"),
        autosave_saved_value: t("take.saved"),
        autosave_failed_value: t("take.save_failed"),
        run_progress_answered_value: t("take.progress_answered", n: "%{n}"),
        run_progress_empty_value: t("take.progress_empty", n: "%{n}"),
        action: "countdown:ended@window->autosave#save input->run-progress#refresh change->run-progress#refresh ordering:changed->autosave#save ordering:changed->run-progress#orderingChanged matching:changed->autosave#save matching:changed->run-progress#refresh"
      },
      class: "space-y-8" do %>
  <%= hidden_field_tag :attempt_id, @attempt.id %>

  <%# Status enters the flow before the questions, then stays at the top while the
      student works. A bottom-sticky bar covered the next question on a phone. %>
  <div class="run-bar">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
      <div class="flex flex-wrap items-center gap-3">
        <% if @attempt.deadline_at %>
          <div data-controller="countdown"
               data-countdown-deadline-value="<%= @attempt.deadline_at.iso8601 %>"
               data-countdown-server-time-value="<%= server_now.iso8601 %>"
               class="countdown">
            <svg class="size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="10" cy="10" r="7.25" /><path d="M10 6.25V10l2.5 1.75" />
            </svg>
            <span data-countdown-target="display">--:--</span>
          </div>
        <% end %>
        <div class="flex items-center gap-1.5 text-xs">
          <svg data-autosave-target="spinner" class="hidden size-3.5 animate-spin text-ink-subtle" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="2" class="opacity-25" />
            <path d="M14 8a6 6 0 0 0-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <svg data-autosave-target="check" class="hidden size-3.5 text-success" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3.5 8.5 6.5 11.5 12.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <p class="autosave-status" data-autosave-target="status"><%= t("take.autosave") %></p>
        </div>
      </div>
      <nav class="run-progress" aria-label="<%= t("take.progress") %>">
        <% @questions.each_with_index do |question, index| %>
          <% started = answer_started?(question, @answers[question.id]) %>
          <%= link_to "##{dom_id(question)}",
                class: "run-progress-mark",
                data: {
                  run_progress_target: "mark",
                  question_id: question.id,
                  answered: started
                },
                aria: { label: t(started ? "take.progress_answered" : "take.progress_empty", n: index + 1) } do %>
            <span class="sr-only"><%= index + 1 %></span>
          <% end %>
        <% end %>
      </nav>
    </div>
  </div>

  <% @questions.each_with_index do |question, index| %>
    <% answer = @answers[question.id] %>
    <fieldset class="qcard" id="<%= dom_id(question) %>"
              data-qtype="<%= question.question_type %>"
              data-question-id="<%= question.id %>"
              data-run-progress-target="card"
              data-answered="<%= answer_started?(question, answer) %>">
      <legend class="sr-only">
        <%= t("take.question_legend", n: index + 1) %>,
        <%= t("exams.points", count: question.points) %>
      </legend>
      <div class="mb-4 flex items-baseline gap-4">
        <p class="qcard-num" aria-hidden="true"><%= index + 1 %></p>
        <p class="text-sm text-ink-muted">
          <%= t("take.type_hint.#{question.question_type}") %>
          <span aria-hidden="true"> · </span>
          <%= t("exams.points", count: question.points) %>
        </p>
      </div>
      <%= render "questions/photo", question: question %>
      <% unless question.source? %>
        <p class="mb-4 text-lg leading-relaxed font-medium whitespace-pre-wrap text-ink"><%= question.prompt %></p>
      <% end %>

      <% if question.mcq? %>
        <div class="space-y-2">
          <% question.student_facing_options.each do |opt| %>
            <label class="option">
              <%= radio_button_tag "answers[#{question.id}][option_id]", opt["id"], answer&.option_id == opt["id"], class: "mt-0.5 size-5 shrink-0 accent-accent" %>
              <span><%= opt["text"] %></span>
            </label>
          <% end %>
        </div>
      <% elsif question.ordering? %>
        <div data-controller="ordering" class="space-y-2">
          <p class="text-sm text-ink-muted"><%= t("take.ordering.hint") %></p>
          <div class="space-y-2" role="list">
            <% question.display_items_for(answer, @attempt.id).each_with_index do |item, item_index| %>
              <div data-ordering-target="item"
                   data-action="click->ordering#place keydown->ordering#keydown"
                   role="listitem"
                   tabindex="0"
                   aria-selected="false"
                   class="order-item">
                <span data-ordering-target="position" class="order-position"><%= item_index + 1 %></span>
                <button type="button"
                        data-ordering-handle
                        data-action="pointerdown->ordering#startDrag"
                        class="order-handle"
                        aria-label="<%= t("take.ordering.drag") %>">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="pointer-events-none size-5">
                    <path d="M7 4a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm0 6a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm0 6a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm8-12a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm0 6a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm0 6a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z"/>
                  </svg>
                </button>
                <%= hidden_field_tag "answers[#{question.id}][order][]", item["id"], id: nil %>
                <span class="flex-1 text-sm"><%= item["text"] %></span>
              </div>
            <% end %>
          </div>
        </div>
      <% elsif question.matching? %>
        <% given = answer&.pairs || {} %>
        <% rights = question.shuffled_right_items(@attempt.id) %>
        <div data-controller="matching" class="space-y-3">
          <p class="text-sm text-ink-muted"><%= t("take.matching.hint") %></p>
          <div class="grid gap-4 sm:grid-cols-2">
            <ul class="space-y-2">
              <% question.student_facing_left.each do |left| %>
                <% paired_right = rights.find { |item| item["id"] == given[left["id"]] } %>
                <li>
                  <button type="button"
                          class="match-item"
                          data-matching-target="left"
                          data-id="<%= left["id"] %>"
                          data-paired="<%= paired_right ? "true" : "false" %>"
                          data-action="click->matching#pickLeft keydown.esc->matching#clearLeftSelection"
                          aria-selected="false">
                    <span><%= left["text"] %></span>
                    <span data-matching-pair class="block text-sm font-normal text-ink-muted"><%= paired_right&.fetch("text") %></span>
                  </button>
                </li>
              <% end %>
            </ul>
            <ul class="space-y-2">
              <% rights.each do |right| %>
                <li>
                  <button type="button"
                          class="match-item"
                          data-matching-target="right"
                          data-id="<%= right["id"] %>"
                          data-paired="<%= given.value?(right["id"]) ? "true" : "false" %>"
                          data-action="click->matching#pickRight">
                    <%= right["text"] %>
                  </button>
                </li>
              <% end %>
            </ul>
          </div>
          <% question.student_facing_left.each do |left| %>
            <%= hidden_field_tag "answers[#{question.id}][pairs][#{left["id"]}]", given[left["id"]],
                  id: nil,
                  data: { matching_target: "input", left_id: left["id"] } %>
          <% end %>
        </div>
      <% elsif question.short_text? %>
        <%= text_field_tag "answers[#{question.id}][text]", answer&.text_response,
              maxlength: 300,
              placeholder: t("take.placeholder.short_text"),
              class: "#{field_class} mt-0" %>
      <% elsif question.source? %>
        <div class="mb-3">
          <p class="mb-1.5 text-xs font-medium text-ink-muted"><%= t("take.source.label") %></p>
          <div class="source-text max-h-80"><%= question.source_text %></div>
        </div>
        <p class="mb-4 text-lg leading-relaxed font-medium whitespace-pre-wrap text-ink"><%= question.prompt %></p>
        <%= text_area_tag "answers[#{question.id}][text]", answer&.text_response,
              rows: 8,
              placeholder: t("take.placeholder.source"),
              class: "#{field_class} mt-0 min-h-40" %>
      <% else %>
        <%= text_area_tag "answers[#{question.id}][text]", answer&.text_response,
              rows: 8,
              placeholder: t("take.placeholder.open"),
              class: "#{field_class} mt-0 min-h-40" %>
      <% end %>
    </fieldset>
  <% end %>

  <%# button_tag, not submit_tag: the seal icon needs a <button> that can hold markup. %>
  <%= button_tag safe_join([ ui_icon("stamp"), t("take.submit") ]), class: "btn btn-primary btn-lg w-full", data: { turbo_confirm: t("take.submit_confirm") } %>
<% end %>
