<% content_for :title, @exam.title %>
<div class="space-y-6">
  <div>
    <p class="text-sm text-slate-500"><%= t("take.hello", name: @student.name) %></p>
    <h1 class="mt-1 text-3xl font-semibold"><%= @exam.title %></h1>
    <% if @exam.description.present? %>
      <p class="mt-3 text-slate-700 whitespace-pre-wrap"><%= @exam.description %></p>
    <% end %>
  </div>

  <ul class="space-y-1 text-sm text-slate-700">
    <li><%= t("take.time_limit", value: @exam.time_limit_sec ? t("take.minutes", count: @exam.time_limit_sec / 60) : t("take.none")) %></li>
    <li><%= t("take.attempts_used", used: @attempts_used, max: @exam.max_attempts) %></li>
    <li><%= t("take.questions", count: @exam.questions.count) %></li>
    <% if @exam.available_from %>
      <li><%= t("take.opens", time: l(@exam.available_from, format: :short)) %></li>
    <% end %>
    <% if @exam.available_until %>
      <li><%= t("take.closes", time: l(@exam.available_until, format: :short)) %></li>
    <% end %>
  </ul>

  <% if @assignment.revoked? %>
    <p class="rounded-md bg-red-50 px-3 py-2 text-red-700"><%= t("take.errors.link_revoked") %></p>
  <% elsif @active_attempt %>
    <%= button_to t("take.resume"), student_start_path(token: @assignment.access_token), class: "#{btn_primary} w-full justify-center" %>
  <% elsif @can_start %>
    <%= button_to t("take.start"), student_start_path(token: @assignment.access_token), class: "#{btn_primary} w-full justify-center" %>
  <% else %>
    <% if @availability == :not_yet_open %>
      <p class="rounded-md bg-amber-50 px-3 py-2 text-amber-800"><%= t("take.errors.not_available_yet") %></p>
    <% elsif @availability == :closed_window %>
      <p class="rounded-md bg-amber-50 px-3 py-2 text-amber-800"><%= t("take.errors.no_longer_available") %></p>
    <% elsif !@exam.published? %>
      <p class="rounded-md bg-slate-100 px-3 py-2 text-slate-700"><%= t("take.errors.test_not_open") %></p>
    <% else %>
      <p class="rounded-md bg-slate-100 px-3 py-2 text-slate-700"><%= t("take.cannot_start") %></p>
    <% end %>
    <% if @assignment.attempts.where(status: %i[submitted expired]).exists? %>
      <%= link_to t("take.view_done"), student_done_path(token: @assignment.access_token), class: "underline text-sm" %>
    <% end %>
  <% end %>
</div>
