<% content_for :title, @exam.title %>
<%= render "exams/header", exam: @exam %>

<div class="mb-8 space-y-3">
  <% if @exam.description.present? %>
    <p class="text-sm leading-relaxed whitespace-pre-wrap text-ink-muted"><%= @exam.description %></p>
  <% end %>
  <div class="flex flex-wrap items-center gap-2">
    <span class="chip"><%= @exam.time_limit_sec ? t("exams.show.minutes_limit", minutes: @exam.time_limit_sec / 60) : t("exams.show.untimed") %></span>
    <span class="chip"><%= t("exams.attempts_count", count: @exam.max_attempts) %></span>
    <% if @exam.available_from || @exam.available_until %>
      <span class="chip">
        <%= t("exams.show.window") %>:
        <%= @exam.available_from ? l(@exam.available_from, format: :short) : t("common.now") %>
        –
        <%= @exam.available_until ? l(@exam.available_until, format: :short) : t("common.open_ended") %>
      </span>
    <% end %>
  </div>
</div>

<section class="mb-8">
  <h2 class="section-title mb-3"><%= t("exams.show.questions") %></h2>
  <% if @questions.any? %>
    <ol class="space-y-3">
      <% @questions.each_with_index do |question, index| %>
        <li class="card card-pad">
          <div class="mb-2 flex flex-wrap items-start justify-between gap-2">
            <div class="flex flex-wrap items-center gap-2 text-xs text-ink-muted">
              <span class="num font-semibold">№<%= index + 1 %></span>
              <span class="chip"><%= t("question_types.#{question.question_type}") %></span>
              <span><%= t("exams.points", count: question.points) %></span>
            </div>
            <% if @exam.questions_editable? %>
              <%= button_to t("exams.show.remove"), test_question_path(@exam, question), method: :delete, form: { data: { turbo_confirm: t("exams.show.remove_confirm") } }, class: "#{btn_danger} btn-sm" %>
            <% end %>
          </div>
          <%= render "questions/photo", question: question %>
          <p class="font-medium whitespace-pre-wrap text-ink"><%= question.prompt %></p>
          <% if question.source? && question.source_text.present? %>
            <div class="source-text mt-3 max-h-48"><%= question.source_text %></div>
          <% end %>
          <% if question.mcq? %>
            <%# A marker and an indent, so four options read as a list under the
                prompt rather than as four more lines of it. %>
            <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-ink marker:text-ink-subtle">
              <% question.options.each do |opt| %>
                <li>
                  <%= opt["text"] %>
                  <% if opt["is_correct"] %><span class="badge badge-success ml-1 align-middle"><%= t("exams.show.correct") %></span><% end %>
                </li>
              <% end %>
            </ul>
          <% elsif question.ordering? %>
            <ol class="mt-3 list-decimal space-y-1 pl-5 text-sm text-ink">
              <% question.items.each do |item| %>
                <li><%= item["text"] %></li>
              <% end %>
            </ol>
          <% elsif question.matching? %>
            <ul class="mt-3 space-y-1 text-sm text-ink">
              <% question.left_items.each do |left| %>
                <% right = question.right_items.find { |item| item["id"] == question.pairs[left["id"]] } %>
                <li><%= left["text"] %> <span class="text-ink-muted">→</span> <%= right&.fetch("text", t("common.dash")) %></li>
              <% end %>
            </ul>
          <% end %>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="empty-state"><%= t("exams.show.no_questions") %></p>
  <% end %>
</section>

<% if @exam.questions_editable? %>
  <section class="card card-pad">
    <h2 class="section-title mb-4"><%= t("exams.show.add_question") %></h2>
    <%= form_with url: test_questions_path(@exam), scope: :question, class: "space-y-4" do |f| %>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="fieldset">
          <%= f.label :question_type, t("exams.show.type"), class: "field-label" %>
          <%= f.select :question_type, Question.question_types.keys.map { |k| [ t("question_types.#{k}"), k ] }, {}, class: field_class, id: "question_type_select" %>
        </div>
        <div class="fieldset">
          <%= f.label :points, class: "field-label" %>
          <%= f.number_field :points, value: 1, min: 1, class: field_class %>
        </div>
      </div>
      <div class="fieldset">
        <%= f.label :photo, t("exams.show.photo"), class: "field-label" %>
        <%= f.file_field :photo, accept: "image/jpeg,image/png,image/webp,image/gif", class: field_class %>
        <p class="field-hint"><%= t("exams.show.photo_hint") %></p>
      </div>

      <div id="source_fields" class="fieldset hidden">
        <label class="field-label"><%= t("exams.show.source") %></label>
        <textarea name="question[source]" rows="8" placeholder="<%= t("exams.show.source_placeholder") %>" class="<%= field_class %>"></textarea>
        <p class="field-hint"><%= t("exams.show.source_hint") %></p>
      </div>

      <div class="fieldset">
        <%= f.label :prompt, t("exams.show.prompt"), class: "field-label", id: "question_prompt_label" %>
        <%= f.text_area :prompt, rows: 3, required: true, class: field_class %>
      </div>

      <div id="mcq_fields" class="space-y-2">
        <p class="field-label"><%= t("exams.show.options_hint_title") %></p>
        <% 4.times do |i| %>
          <div class="flex items-center gap-2.5">
            <%= radio_button_tag "question[correct_index]", i, i == 0, id: "correct_#{i}", class: "size-4 shrink-0 accent-accent" %>
            <input type="text" name="question[options][<%= i %>][text]" placeholder="<%= t("exams.show.option_placeholder", n: i + 1) %>" class="<%= field_class %> mt-0">
          </div>
        <% end %>
        <p class="field-hint"><%= t("exams.show.options_hint") %></p>
      </div>

      <div id="text_fields" class="hidden space-y-3">
        <div class="fieldset">
          <label class="field-label"><%= t("exams.show.rubric") %></label>
          <textarea name="question[rubric]" rows="2" class="<%= field_class %>"></textarea>
        </div>
        <div class="fieldset">
          <label class="field-label"><%= t("exams.show.model_answer") %></label>
          <textarea name="question[model_answer]" rows="2" class="<%= field_class %>"></textarea>
        </div>
      </div>

      <div id="ordering_fields" class="hidden space-y-2">
        <p class="field-label"><%= t("exams.show.ordering_hint_title") %></p>
        <% 8.times do |i| %>
          <input type="text" name="question[items][<%= i %>][text]" placeholder="<%= t("exams.show.ordering_placeholder", n: i + 1) %>" class="<%= field_class %> mt-0">
        <% end %>
        <p class="field-hint"><%= t("exams.show.ordering_hint") %></p>
      </div>

      <div id="matching_fields" class="hidden space-y-2">
        <p class="field-label"><%= t("exams.show.matching_hint_title") %></p>
        <div class="grid gap-2 text-xs font-medium text-ink-muted sm:grid-cols-2">
          <p><%= t("exams.show.matching_left") %></p>
          <p class="hidden sm:block"><%= t("exams.show.matching_right") %></p>
        </div>
        <% 5.times do |i| %>
          <div class="grid gap-2 sm:grid-cols-2">
            <input type="text" name="question[pairs][<%= i %>][left]" placeholder="<%= t("exams.show.matching_left_placeholder", n: i + 1) %>" class="<%= field_class %> mt-0">
            <input type="text" name="question[pairs][<%= i %>][right]" placeholder="<%= t("exams.show.matching_right_placeholder", n: i + 1) %>" class="<%= field_class %> mt-0">
          </div>
        <% end %>
        <p class="field-hint"><%= t("exams.show.matching_hint") %></p>
      </div>

      <%= f.submit t("exams.show.submit_question"), class: btn_primary %>
    <% end %>
  </section>

  <script>
    (function() {
      const select = document.getElementById("question_type_select");
      const mcq = document.getElementById("mcq_fields");
      const text = document.getElementById("text_fields");
      const ordering = document.getElementById("ordering_fields");
      const matching = document.getElementById("matching_fields");
      const source = document.getElementById("source_fields");
      const promptLabel = document.getElementById("question_prompt_label");
      const promptDefault = <%= t("exams.show.prompt").to_json.html_safe %>;
      const promptInstruction = <%= t("exams.show.instruction").to_json.html_safe %>;
      function sync() {
        const type = select.value;
        mcq.classList.toggle("hidden", type !== "mcq");
        text.classList.toggle("hidden", type !== "short_text" && type !== "open" && type !== "source");
        ordering.classList.toggle("hidden", type !== "ordering");
        matching.classList.toggle("hidden", type !== "matching");
        source.classList.toggle("hidden", type !== "source");
        promptLabel.textContent = type === "source" ? promptInstruction : promptDefault;
      }
      select.addEventListener("change", sync);
      sync();
    })();
  </script>
<% end %>
