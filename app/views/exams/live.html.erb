<% content_for :title, t("exams.live.title", title: @exam.title) %>
<%= turbo_stream_from @exam, :live_board %>

<div data-controller="live-board"
     data-live-board-interval-value="4000"
     data-live-board-src-value="<%= live_test_path(@exam) %>"
     data-live-board-toast-one-value="<%= t("exams.live.toast_one") %>"
     data-live-board-toast-other-value="<%= t("exams.live.toast_other", count: "__COUNT__") %>">
  <%= render "exams/header", exam: @exam %>

  <p class="mb-1 text-sm text-ink-muted"><%= t("exams.live.hint") %></p>
  <p class="mb-4 text-sm text-ink-muted"><%= t("exams.live.focus_hint") %></p>

  <%# The controller writes textContent here, so keep it text-only. %>
  <p id="live-toast" class="flash flash-notice hidden" role="status"></p>

  <%= turbo_frame_tag "live_board", src: live_test_path(@exam) do %>
    <p class="text-sm text-ink-muted"><%= t("exams.live.loading") %></p>
  <% end %>
</div>
