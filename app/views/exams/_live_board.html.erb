<%= turbo_frame_tag "live_board" do %>
  <%
    submitted_ids = assignments.filter_map { |a| a.latest_attempt&.id if a.latest_attempt&.submitted? }
  %>
  <div id="live-board-data"
       data-submitted-ids="<%= submitted_ids.join(",") %>"
       data-server-time="<%= server_time.iso8601(3) %>">
    <div class="mb-4 grid grid-cols-2 gap-2 sm:grid-cols-5">
      <% %w[in_progress not_started submitted expired revoked].each do |status| %>
        <div class="card px-3 py-2">
          <p class="text-xs text-ink-muted"><%= t("statuses.#{status}") %></p>
          <p class="num mt-0.5 text-lg font-semibold text-ink"><%= counts[status].to_i %></p>
        </div>
      <% end %>
    </div>

    <% if assignments.any? %>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th><%= t("exams.assign.student") %></th>
              <th><%= t("exams.assign.status") %></th>
              <th><%= t("attempts.history.started") %></th>
              <th><%= t("exams.live.last_activity") %></th>
              <th><%= t("exams.results.submitted") %></th>
              <th><%= t("exams.live.time_left") %></th>
              <th><%= t("exams.live.tab_switches") %></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% assignments.each do |assignment| %>
              <% attempt = assignment.latest_attempt %>
              <tr>
                <td class="font-medium"><%= assignment.student.name %></td>
                <td><%= status_badge(assignment.board_status) %></td>
                <td class="text-ink-muted"><%= attempt ? l(attempt.started_at, format: :short) : t("common.dash") %></td>
                <td class="text-ink-muted"><%= attempt ? l(attempt.last_activity_at, format: :short) : t("common.dash") %></td>
                <td class="text-ink-muted"><%= attempt&.submitted_at ? l(attempt.submitted_at, format: :short) : t("common.dash") %></td>
                <td class="num">
                  <% if attempt&.in_progress? && attempt.deadline_at %>
                    <span class="countdown-cell"
                          data-controller="countdown"
                          data-countdown-deadline-value="<%= attempt.deadline_at.iso8601 %>"
                          data-countdown-server-time-value="<%= server_time.iso8601 %>">
                      <span data-countdown-target="display"><%= countdown_display(attempt.seconds_remaining(server_time)) %></span>
                    </span>
                  <% else %>
                    <span class="text-ink-muted"><%= t("common.dash") %></span>
                  <% end %>
                </td>
                <td class="num">
                  <% if attempt && attempt.focus_loss_count.positive? %>
                    <span class="focus-losses font-medium text-ink"><%= attempt.focus_loss_count %></span>
                  <% else %>
                    <span class="text-ink-muted"><%= t("common.dash") %></span>
                  <% end %>
                </td>
                <td class="text-right">
                  <% if attempt && (attempt.submitted? || attempt.expired?) %>
                    <%= link_to t("exams.results.grade"), attempt_path(attempt), class: "link", data: { turbo_frame: "_top" } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="empty-state">
        <%= t("exams.live.empty") %>
        <%= link_to t("exams.live.assign_students"), manage_test_assignments_path(exam), class: "link", data: { turbo_frame: "_top" } %>
      </p>
    <% end %>
  </div>
<% end %>
