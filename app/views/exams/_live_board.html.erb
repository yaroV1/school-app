<%= turbo_frame_tag "live_board" do %>
  <%
    submitted_ids = @assignments.filter_map { |a| a.latest_attempt&.id if a.latest_attempt&.submitted? }
  %>
  <div id="live-board-data"
       data-submitted-ids="<%= submitted_ids.join(",") %>"
       data-server-time="<%= @server_time.iso8601 %>">
    <div class="mb-4 flex flex-wrap gap-3 text-sm">
      <% %w[in_progress not_started submitted expired revoked].each do |status| %>
        <span class="rounded-full border border-slate-200 bg-white px-3 py-1">
          <%= status.humanize %>: <strong><%= @counts[status].to_i %></strong>
        </span>
      <% end %>
    </div>

    <% if @assignments.any? %>
      <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
        <table class="min-w-full text-sm">
          <thead class="bg-slate-50 text-left text-slate-600">
            <tr>
              <th class="px-3 py-2">Student</th>
              <th class="px-3 py-2">Status</th>
              <th class="px-3 py-2">Started</th>
              <th class="px-3 py-2">Last activity</th>
              <th class="px-3 py-2">Submitted</th>
              <th class="px-3 py-2">Time left</th>
              <th class="px-3 py-2"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @assignments.each do |assignment| %>
              <% attempt = assignment.latest_attempt %>
              <tr>
                <td class="px-3 py-2 font-medium"><%= assignment.student.name %></td>
                <td class="px-3 py-2"><%= status_badge(assignment.board_status) %></td>
                <td class="px-3 py-2"><%= attempt ? l(attempt.started_at, format: :short) : "—" %></td>
                <td class="px-3 py-2"><%= attempt ? l(attempt.last_activity_at, format: :short) : "—" %></td>
                <td class="px-3 py-2"><%= attempt&.submitted_at ? l(attempt.submitted_at, format: :short) : "—" %></td>
                <td class="px-3 py-2 font-mono">
                  <% if attempt&.in_progress? && attempt.deadline_at %>
                    <%= attempt.seconds_remaining(@server_time) %>s
                  <% else %>
                    —
                  <% end %>
                </td>
                <td class="px-3 py-2 text-right">
                  <% if attempt && (attempt.submitted? || attempt.expired?) %>
                    <%= link_to "Grade", attempt_path(attempt), class: "underline", data: { turbo_frame: "_top" } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-slate-600">
        No assignments yet.
        <%= link_to "Assign students", manage_test_assignments_path(@exam), class: "underline", data: { turbo_frame: "_top" } %>.
      </p>
    <% end %>
  </div>
<% end %>
