<div class="mb-6">
  <%= link_to exam.class_group.name, class_group_path(exam.class_group), class: "text-sm text-slate-600 underline" %>
  <span class="text-sm text-slate-400"> / </span>
  <%= link_to exam.subject.name, subject_path(exam.subject), class: "text-sm text-slate-600 underline" %>
  <div class="mt-2 flex flex-wrap items-start justify-between gap-4">
    <div class="flex items-center gap-2">
      <h1 class="text-2xl font-semibold"><%= exam.title %></h1>
      <%= status_badge(exam.status) %>
    </div>
    <% if exam.draft? %>
      <%= button_to t("exams.show.publish"), publish_test_path(exam), form: { data: { turbo_confirm: t("exams.show.publish_confirm") } }, class: btn_primary %>
    <% elsif exam.published? %>
      <%= button_to t("exams.show.close"), close_test_path(exam), form: { data: { turbo_confirm: t("exams.show.close_confirm") } }, class: btn_secondary %>
    <% end %>
  </div>
</div>

<%= render "exams/tabs", exam: exam %>
