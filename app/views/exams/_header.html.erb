<div class="mb-6">
  <%= render "shared/breadcrumbs", crumbs: [
        [ t("classes.index.title"), class_groups_path ],
        [ exam.class_group.name, class_group_path(exam.class_group) ],
        [ exam.subject.name, subject_path(exam.subject) ],
        [ exam.title, nil ]
      ] %>
  <div class="mt-3 flex flex-wrap items-start justify-between gap-3">
    <div class="flex flex-wrap items-center gap-2">
      <h1 class="page-title"><%= exam.title %></h1>
      <%= status_badge(exam.status) %>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <details class="menu">
        <summary class="<%= btn_secondary %>"><%= safe_join([ ui_icon("copy"), t("exams.show.duplicate") ]) %></summary>
        <div class="menu-panel">
          <p class="menu-heading"><%= t("exams.show.duplicate_target") %></p>
          <%= form_with url: duplicate_test_path(exam) do %>
            <% subject_targets_by_class.each do |group, subjects| %>
              <p class="menu-heading"><%= group.name %></p>
              <% subjects.each do |subject| %>
                <%= button_tag name: "subject_id", value: subject.id, class: "menu-item" do %>
                  <%= subject.name %>
                  <% if subject == exam.subject %>
                    <span class="text-ink-subtle">· <%= t("exams.show.duplicate_current") %></span>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </details>
      <% if exam.draft? %>
        <%= button_to safe_join([ ui_icon("banner"), t("exams.show.publish") ]), publish_test_path(exam), form: { data: { turbo_confirm: t("exams.show.publish_confirm") } }, class: btn_primary %>
      <% elsif exam.published? %>
        <%= button_to safe_join([ ui_icon("lock"), t("exams.show.close") ]), close_test_path(exam), form: { data: { turbo_confirm: t("exams.show.close_confirm") } }, class: btn_secondary %>
      <% end %>
    </div>
  </div>
</div>

<%= render "exams/tabs", exam: exam %>
