<div class="mb-6">
  <%= render "shared/breadcrumbs", crumbs: [
        [ t("classes.index.title"), class_groups_path ],
        [ exam.class_group.name, class_group_path(exam.class_group) ],
        [ exam.subject.name, subject_path(exam.subject) ],
        [ exam.title, nil ]
      ] %>
  <div class="mt-3 flex flex-wrap items-start justify-between gap-3">
    <div class="flex flex-wrap items-center gap-2">
      <h1 class="page-title"><%= exam.title %></h1>
      <%= status_badge(exam.status) %>
    </div>
    <% if exam.draft? %>
      <%= button_to t("exams.show.publish"), publish_test_path(exam), form: { data: { turbo_confirm: t("exams.show.publish_confirm") } }, class: btn_primary %>
    <% elsif exam.published? %>
      <%= button_to t("exams.show.close"), close_test_path(exam), form: { data: { turbo_confirm: t("exams.show.close_confirm") } }, class: btn_secondary %>
    <% end %>
  </div>
</div>

<%= render "exams/tabs", exam: exam %>
