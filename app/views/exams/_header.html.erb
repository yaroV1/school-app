<div class="mb-6">
  <%= render "shared/breadcrumbs", crumbs: [
        [ t("classes.index.title"), class_groups_path ],
        [ exam.class_group.name, class_group_path(exam.class_group) ],
        [ exam.subject.name, subject_path(exam.subject) ],
        [ exam.title, nil ]
      ] %>
  <div class="mt-3 flex flex-wrap items-start justify-between gap-3">
    <div class="flex flex-wrap items-center gap-2">
      <h1 class="page-title"><%= exam.title %></h1>
      <%= status_badge(exam.status) %>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <div data-controller="modal">
        <button type="button" class="<%= btn_secondary %>" data-action="modal#open">
          <%= safe_join([ ui_icon("copy"), t("exams.show.duplicate") ]) %>
        </button>
        <dialog class="modal" aria-labelledby="duplicate_title"
                data-modal-target="dialog" data-action="click->modal#closeOnBackdrop">
          <%= form_with url: duplicate_test_path(exam), class: "modal-form",
                        data: { action: "change->modal#refresh" } do %>
            <div class="modal-head">
              <h2 id="duplicate_title" class="modal-title"><%= t("exams.show.duplicate_target") %></h2>
              <p class="modal-hint"><%= t("exams.show.duplicate_hint") %></p>
            </div>
            <div class="modal-body">
              <% subject_targets_by_class.each do |group, subjects| %>
                <p class="modal-group"><%= group.name %></p>
                <% subjects.each do |subject| %>
                  <label class="modal-option" for="duplicate_subject_<%= subject.id %>">
                    <%= check_box_tag "subject_ids[]", subject.id, subject == exam.subject,
                          id: "duplicate_subject_#{subject.id}", class: "size-4 shrink-0 accent-accent" %>
                    <span><%= subject.name %></span>
                    <% if subject == exam.subject %>
                      <span class="text-ink-subtle">· <%= t("exams.show.duplicate_current") %></span>
                    <% end %>
                  </label>
                <% end %>
              <% end %>
            </div>
            <div class="modal-actions">
              <button type="button" class="<%= btn_secondary %>" data-action="modal#close">
                <%= t("exams.show.duplicate_cancel") %>
              </button>
              <%= submit_tag t("exams.show.duplicate_submit"), class: btn_primary,
                    data: { modal_target: "submit" } %>
            </div>
          <% end %>
        </dialog>
      </div>
      <% if exam.draft? %>
        <%= button_to safe_join([ ui_icon("banner"), t("exams.show.publish") ]), publish_test_path(exam), form: { data: { turbo_confirm: t("exams.show.publish_confirm") } }, class: btn_primary %>
      <% elsif exam.published? %>
        <%= button_to safe_join([ ui_icon("lock"), t("exams.show.close") ]), close_test_path(exam), form: { data: { turbo_confirm: t("exams.show.close_confirm") } }, class: btn_secondary %>
      <% end %>
    </div>
  </div>
</div>

<%= render "exams/tabs", exam: exam %>
