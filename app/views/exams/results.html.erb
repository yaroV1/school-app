<% content_for :title, t("exams.results.title", title: @exam.title) %>
<%= render "exams/header", exam: @exam %>

<% if @assignments.any? %>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t("exams.assign.student") %></th>
          <th><%= t("exams.results.latest_status") %></th>
          <th><%= t("attempts.history.started") %></th>
          <th><%= t("exams.results.submitted") %></th>
          <th><%= t("exams.results.score") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @assignments.each do |assignment| %>
          <% attempt = assignment.latest_attempt %>
          <tr>
            <td><%= link_to assignment.student.name, student_path(assignment.student), class: "link-quiet" %></td>
            <td>
              <% if attempt %>
                <%= status_badge(attempt.status) %>
                <span class="num text-xs text-ink-muted">№<%= attempt.attempt_no %></span>
              <% else %>
                <span class="badge badge-neutral"><%= t("statuses.not_started") %></span>
              <% end %>
            </td>
            <td class="text-ink-muted"><%= attempt ? l(attempt.started_at, format: :short) : t("common.dash") %></td>
            <td class="text-ink-muted"><%= attempt&.submitted_at ? l(attempt.submitted_at, format: :short) : t("common.dash") %></td>
            <td class="num">
              <% if attempt&.grade %>
                <%= attempt.grade.total_score || t("common.dash") %>/<%= attempt.grade.max_score %>
                <% if attempt.grade.finalized_by_teacher? %>
                  <span class="badge badge-success"><%= t("exams.results.finalized") %></span>
                <% end %>
              <% else %>
                <span class="text-ink-muted"><%= t("common.dash") %></span>
              <% end %>
            </td>
            <td class="text-right">
              <% if attempt %><%= link_to t("exams.results.grade"), attempt_path(attempt), class: "link" %><% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="empty-state"><%= t("exams.results.empty") %></p>
<% end %>
