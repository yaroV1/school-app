<% content_for :title, t("exams.results.title", title: @exam.title) %>
<%= render "exams/header", exam: @exam %>

<% if @assignments.any? %>
  <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
    <table class="min-w-full text-sm">
      <thead class="bg-slate-50 text-left text-slate-600">
        <tr>
          <th class="px-3 py-2"><%= t("exams.assign.student") %></th>
          <th class="px-3 py-2"><%= t("exams.results.latest_status") %></th>
          <th class="px-3 py-2"><%= t("attempts.history.started") %></th>
          <th class="px-3 py-2"><%= t("exams.results.submitted") %></th>
          <th class="px-3 py-2"><%= t("exams.results.score") %></th>
          <th class="px-3 py-2"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @assignments.each do |assignment| %>
          <% attempt = assignment.latest_attempt %>
          <tr>
            <td class="px-3 py-2"><%= link_to assignment.student.name, student_path(assignment.student), class: "underline" %></td>
            <td class="px-3 py-2">
              <% if attempt %>
                <%= status_badge(attempt.status) %> (№<%= attempt.attempt_no %>)
              <% else %>
                <span class="text-slate-500"><%= t("statuses.not_started") %></span>
              <% end %>
            </td>
            <td class="px-3 py-2"><%= attempt ? l(attempt.started_at, format: :short) : t("common.dash") %></td>
            <td class="px-3 py-2"><%= attempt&.submitted_at ? l(attempt.submitted_at, format: :short) : t("common.dash") %></td>
            <td class="px-3 py-2">
              <% if attempt&.grade %>
                <%= attempt.grade.total_score || t("common.dash") %>/<%= attempt.grade.max_score %>
                <%= "· #{t("exams.results.finalized")}" if attempt.grade.finalized_by_teacher? %>
              <% else %>
                <%= t("common.dash") %>
              <% end %>
            </td>
            <td class="px-3 py-2 text-right">
              <% if attempt %><%= link_to t("exams.results.grade"), attempt_path(attempt), class: "underline" %><% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-slate-600"><%= t("exams.results.empty") %></p>
<% end %>
