<% content_for :title, title_parts(t("exams.new.title"), @exam.subject.name) %>
<div class="mb-6">
  <%= render "shared/breadcrumbs", crumbs: [
        [ t("classes.index.title"), class_groups_path ],
        [ @exam.class_group.name, class_group_path(@exam.class_group) ],
        [ @exam.subject.name, subject_path(@exam.subject) ],
        [ t("exams.new.title"), nil ]
      ] %>
  <h1 class="page-title mt-3"><%= t("exams.new.title") %></h1>
</div>
<%= render "form", exam: @exam %>
