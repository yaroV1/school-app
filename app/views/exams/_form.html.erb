<%= form_with model: exam, url: exam.persisted? ? test_path(exam) : subject_exams_path(exam.subject), class: "card card-pad max-w-xl space-y-4" do |f| %>
  <%= render "shared/form_errors", record: exam %>
  <div class="fieldset">
    <%= f.label :title, class: "field-label" %>
    <%= f.text_field :title, required: true, class: field_class %>
  </div>
  <div class="fieldset">
    <%= f.label :description, class: "field-label" %>
    <%= f.text_area :description, rows: 3, class: field_class %>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="fieldset">
      <%= f.label :time_limit_sec, t("exams.form.time_limit"), class: "field-label" %>
      <%= f.number_field :time_limit_sec, min: 1, class: field_class %>
    </div>
    <div class="fieldset">
      <%= f.label :max_attempts, class: "field-label" %>
      <%= f.number_field :max_attempts, min: 1, required: true, class: field_class %>
    </div>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div class="fieldset">
      <%= f.label :available_from, t("exams.form.available_from"), class: "field-label" %>
      <%= f.datetime_local_field :available_from, class: field_class,
            value: exam.available_from&.strftime("%Y-%m-%dT%H:%M") %>
    </div>
    <div class="fieldset">
      <%= f.label :available_until, t("exams.form.available_until"), class: "field-label" %>
      <%= f.datetime_local_field :available_until, class: field_class,
            value: exam.available_until&.strftime("%Y-%m-%dT%H:%M") %>
    </div>
  </div>
  <p class="field-hint"><%= t("exams.form.window_hint") %></p>
  <div class="rounded-control border border-line bg-surface-sunken p-3.5">
    <label class="flex items-start gap-3">
      <%= f.check_box :show_results_to_students, class: "mt-0.5 size-4 shrink-0 accent-accent" %>
      <span>
        <span class="block text-sm font-medium text-ink"><%= t("exams.form.show_results_to_students") %></span>
        <span class="mt-1 block text-xs leading-relaxed text-ink-muted"><%= t("exams.form.show_results_hint") %></span>
      </span>
    </label>
  </div>
  <%= f.submit class: btn_primary %>
<% end %>
