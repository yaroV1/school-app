<% content_for :title, t("attempts.grade.title") %>
<%= turbo_stream_from @attempt, :grade_live %>
<div class="mb-6">
  <%= link_to t("attempts.grade.back"), results_test_path(@exam), class: "text-sm text-slate-600 underline" %>
  <h1 class="mt-2 text-2xl font-semibold"><%= t("attempts.grade.heading", name: @attempt.student.name) %></h1>
  <%= render "attempts/live_header", attempt: @attempt, exam: @exam, grade: @grade %>
</div>

<%= form_with url: attempt_path(@attempt), method: :patch, class: "space-y-6" do %>
  <% @questions.each_with_index do |question, index| %>
    <% answer = @answers[question.id] %>
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-sm font-medium text-slate-500">№<%= index + 1 %> · <%= t("question_types.#{question.question_type}") %> · <%= t("exams.points_short", count: question.points) %></p>
      <%= render "questions/photo", question: question %>
      <p class="mt-1 whitespace-pre-wrap font-medium"><%= question.prompt %></p>
      <% if question.source? && question.source_text.present? %>
        <div class="mt-3">
          <p class="mb-1 text-xs font-medium text-stone-600"><%= t("take.source.label") %></p>
          <div class="max-h-56 overflow-y-auto rounded-md border border-stone-200 bg-stone-50 p-3 text-sm whitespace-pre-wrap text-stone-800"><%= question.source_text %></div>
        </div>
      <% end %>

      <%= render "attempts/student_answer", question: question, answer: answer %>

      <%= hidden_field_tag "answers[][question_id]", question.id %>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <div>
          <label class="text-sm font-medium"><%= t("attempts.grade.teacher_score") %></label>
          <%= number_field_tag "answers[][teacher_score]", answer&.teacher_score || (question.auto_gradable? ? answer&.auto_score : nil), min: 0, max: question.points, step: 0.01, class: field_class %>
        </div>
        <div>
          <label class="text-sm font-medium"><%= t("attempts.grade.comment") %></label>
          <%= text_field_tag "answers[][teacher_comment]", answer&.teacher_comment, class: field_class %>
        </div>
      </div>
    </div>
  <% end %>

  <div>
    <label class="text-sm font-medium"><%= t("attempts.grade.overall_comment") %></label>
    <%= text_area_tag :teacher_comment, @grade&.teacher_comment, rows: 2, class: field_class %>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= submit_tag t("attempts.grade.save"), class: btn_secondary %>
    <%= submit_tag t("attempts.grade.save_finalize"), name: "finalize", value: "1", class: btn_primary %>
  </div>
<% end %>
