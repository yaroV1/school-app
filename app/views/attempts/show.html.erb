<% content_for :title, t("attempts.grade.title") %>
<div class="mb-6">
  <%= link_to t("attempts.grade.back"), results_test_path(@exam), class: "text-sm text-slate-600 underline" %>
  <h1 class="mt-2 text-2xl font-semibold"><%= t("attempts.grade.heading", name: @attempt.student.name) %></h1>
  <p class="text-slate-600"><%= @exam.title %> · <%= t("attempts.grade.attempt", n: @attempt.attempt_no) %> · <%= status_badge(@attempt.status) %></p>
  <% if @grade %>
    <p class="mt-1 text-sm text-slate-500">
      <%= t("attempts.grade.current") %>: <%= @grade.total_score || t("common.dash") %>/<%= @grade.max_score %>
      <%= @grade.finalized_by_teacher? ? "· #{t("attempts.grade.finalized")}" : "· #{t("attempts.grade.not_finalized")}" %>
    </p>
  <% end %>
</div>

<%= form_with url: attempt_path(@attempt), method: :patch, class: "space-y-6" do %>
  <% @questions.each_with_index do |question, index| %>
    <% answer = @answers[question.id] %>
    <div class="rounded-lg border border-slate-200 bg-white p-4">
      <p class="text-sm font-medium text-slate-500">№<%= index + 1 %> · <%= t("question_types.#{question.question_type}") %> · <%= t("exams.points_short", count: question.points) %></p>
      <%= render "questions/photo", question: question %>
      <p class="mt-1 whitespace-pre-wrap font-medium"><%= question.prompt %></p>
      <% if question.source? && question.source_text.present? %>
        <div class="mt-3">
          <p class="mb-1 text-xs font-medium text-stone-600"><%= t("take.source.label") %></p>
          <div class="max-h-56 overflow-y-auto rounded-md border border-stone-200 bg-stone-50 p-3 text-sm whitespace-pre-wrap text-stone-800"><%= question.source_text %></div>
        </div>
      <% end %>

      <div class="mt-3 rounded bg-slate-50 p-3 text-sm">
        <p class="mb-1 text-slate-500"><%= t("attempts.grade.student_answer") %></p>
        <% if answer.nil? %>
          <p class="italic text-slate-400"><%= t("attempts.grade.no_answer") %></p>
        <% elsif question.mcq? %>
          <% selected = question.options.find { |o| o["id"] == answer.option_id } %>
          <p><%= selected ? selected["text"] : answer.option_id %></p>
          <p class="mt-1 text-slate-600"><%= t("attempts.grade.auto_score") %>: <%= answer.auto_score %></p>
        <% elsif question.ordering? %>
          <% if answer.order_ids.blank? %>
            <p class="italic text-slate-400"><%= t("attempts.grade.no_answer") %></p>
          <% else %>
            <p class="mb-1 text-slate-500"><%= t("attempts.grade.student_order") %></p>
            <ol class="list-decimal space-y-1 pl-5">
              <% answer.order_ids.each do |id| %>
                <% item = question.items.find { |entry| entry["id"] == id } %>
                <li><%= item ? item["text"] : id %></li>
              <% end %>
            </ol>
            <p class="mt-3 mb-1 text-slate-500"><%= t("attempts.grade.correct_order") %></p>
            <ol class="list-decimal space-y-1 pl-5 text-slate-700">
              <% question.items.each do |item| %>
                <li><%= item["text"] %></li>
              <% end %>
            </ol>
          <% end %>
          <p class="mt-1 text-slate-600"><%= t("attempts.grade.auto_score") %>: <%= answer.auto_score %></p>
        <% elsif question.matching? %>
          <% if answer.pairs.values.all?(&:blank?) %>
            <p class="italic text-slate-400"><%= t("attempts.grade.no_answer") %></p>
          <% else %>
            <ul class="space-y-1">
              <% question.left_items.each do |left| %>
                <% chosen_id = answer.pairs[left["id"]] %>
                <% chosen = question.right_items.find { |item| item["id"] == chosen_id } %>
                <% correct = question.right_items.find { |item| item["id"] == question.pairs[left["id"]] } %>
                <% ok = chosen_id.to_s == question.pairs[left["id"]].to_s %>
                <li>
                  <%= left["text"] %> → <%= chosen ? chosen["text"] : t("common.dash") %>
                  <% if ok %>
                    <span class="text-emerald-700"><%= t("attempts.grade.pair_correct") %></span>
                  <% else %>
                    <span class="text-slate-500"><%= t("attempts.grade.pair_expected", value: correct&.fetch("text", t("common.dash"))) %></span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% end %>
          <p class="mt-1 text-slate-600"><%= t("attempts.grade.auto_score") %>: <%= answer.auto_score %></p>
        <% else %>
          <p class="whitespace-pre-wrap"><%= answer.text_response.presence || t("common.dash") %></p>
        <% end %>
      </div>

      <%= hidden_field_tag "answers[][question_id]", question.id %>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        <div>
          <label class="text-sm font-medium"><%= t("attempts.grade.teacher_score") %></label>
          <%= number_field_tag "answers[][teacher_score]", answer&.teacher_score || (question.auto_gradable? ? answer&.auto_score : nil), min: 0, max: question.points, step: 0.01, class: field_class %>
        </div>
        <div>
          <label class="text-sm font-medium"><%= t("attempts.grade.comment") %></label>
          <%= text_field_tag "answers[][teacher_comment]", answer&.teacher_comment, class: field_class %>
        </div>
      </div>
    </div>
  <% end %>

  <div>
    <label class="text-sm font-medium"><%= t("attempts.grade.overall_comment") %></label>
    <%= text_area_tag :teacher_comment, @grade&.teacher_comment, rows: 2, class: field_class %>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= submit_tag t("attempts.grade.save"), class: btn_secondary %>
    <%= submit_tag t("attempts.grade.save_finalize"), name: "finalize", value: "1", class: btn_primary %>
  </div>
<% end %>
