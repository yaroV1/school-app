<% content_for :title, t("attempts.grade.title") %>
<%# Nothing broadcasts to a finished attempt, so only subscribe while one runs. %>
<%= turbo_stream_from @attempt, :grade_live if @attempt.in_progress? %>
<div class="mb-6">
  <%= render "shared/breadcrumbs", crumbs: [
        [ t("classes.index.title"), class_groups_path ],
        [ @exam.class_group.name, class_group_path(@exam.class_group) ],
        [ @exam.subject.name, subject_path(@exam.subject) ],
        [ @exam.title, test_path(@exam) ],
        [ t("exams.show.results"), results_test_path(@exam) ],
        [ @attempt.student.name, nil ]
      ] %>
  <h1 class="page-title mt-3"><%= t("attempts.grade.heading", name: @attempt.student.name) %></h1>
  <%= render "attempts/live_header", attempt: @attempt, exam: @exam, grade: @grade %>
</div>

<%= form_with url: attempt_path(@attempt), method: :patch, class: "space-y-4" do %>
  <% @questions.each_with_index do |question, index| %>
    <% answer = @answers[question.id] %>
    <div class="card card-pad">
      <div class="flex flex-wrap items-center gap-2 text-xs text-ink-muted">
        <span class="num font-semibold">№<%= index + 1 %></span>
        <span class="chip"><%= t("question_types.#{question.question_type}") %></span>
        <span><%= t("exams.points_short", count: question.points) %></span>
      </div>
      <%= render "questions/photo", question: question %>
      <p class="mt-2 font-medium whitespace-pre-wrap text-ink"><%= question.prompt %></p>
      <% if question.source? && question.source_text.present? %>
        <div class="mt-3">
          <p class="mb-1.5 text-xs font-medium text-ink-muted"><%= t("take.source.label") %></p>
          <div class="source-text max-h-56"><%= question.source_text %></div>
        </div>
      <% end %>

      <%= render "attempts/student_answer", question: question, answer: answer %>

      <%= hidden_field_tag "answers[][question_id]", question.id %>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <div class="fieldset">
          <label class="field-label"><%= t("attempts.grade.teacher_score") %></label>
          <%# Only the teacher's own override. Prefilling the auto score copied a
              value that the live stream then leaves stale, and saving it wrote
              that stale number over a score the student had since improved. %>
          <%= number_field_tag "answers[][teacher_score]", answer&.teacher_score, min: 0, max: question.points, step: 0.01, class: field_class %>
          <% if question.auto_gradable? %>
            <p class="field-hint"><%= t("attempts.grade.auto_score_hint") %></p>
          <% end %>
        </div>
        <div class="fieldset">
          <label class="field-label"><%= t("attempts.grade.comment") %></label>
          <%= text_field_tag "answers[][teacher_comment]", answer&.teacher_comment, class: field_class %>
        </div>
      </div>
    </div>
  <% end %>

  <div class="card card-pad fieldset">
    <label class="field-label"><%= t("attempts.grade.overall_comment") %></label>
    <%= text_area_tag :teacher_comment, @grade&.teacher_comment, rows: 2, class: field_class %>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= submit_tag t("attempts.grade.save"), class: btn_secondary %>
    <%# button_tag, not submit_tag: an options hash overrides submit_tag's label
        argument, so the finalize flag was rendering as the button's caption. %>
    <%= button_tag t("attempts.grade.save_finalize"), type: "submit", name: "finalize", value: "1", class: btn_primary %>
  </div>
<% end %>
