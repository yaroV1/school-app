<div id="<%= dom_id(question, :student_answer) %>" class="mt-3 rounded-control border border-line bg-surface px-3.5 py-3 text-sm">
  <p class="mb-1.5 text-xs font-medium text-ink-muted"><%= t("attempts.grade.student_answer") %></p>
  <% if answer.nil? %>
    <p class="text-ink-subtle italic"><%= t("attempts.grade.no_answer") %></p>
  <% elsif question.mcq? %>
    <% selected = question.options.find { |o| o["id"] == answer.option_id } %>
    <p class="text-ink"><%= selected ? selected["text"] : answer.option_id %></p>
    <p class="mt-2 text-xs text-ink-muted"><%= t("attempts.grade.auto_score") %>: <span class="num"><%= answer.auto_score %></span></p>
  <% elsif question.ordering? %>
    <% if answer.order_ids.blank? %>
      <p class="text-ink-subtle italic"><%= t("attempts.grade.no_answer") %></p>
    <% else %>
      <p class="mb-1 text-xs font-medium text-ink-muted"><%= t("attempts.grade.student_order") %></p>
      <ol class="list-decimal space-y-1 pl-5 text-ink">
        <% answer.order_ids.each do |id| %>
          <% item = question.items.find { |entry| entry["id"] == id } %>
          <li><%= item ? item["text"] : id %></li>
        <% end %>
      </ol>
      <p class="mt-3 mb-1 text-xs font-medium text-ink-muted"><%= t("attempts.grade.correct_order") %></p>
      <ol class="list-decimal space-y-1 pl-5 text-ink-muted">
        <% question.items.each do |item| %>
          <li><%= item["text"] %></li>
        <% end %>
      </ol>
    <% end %>
    <p class="mt-2 text-xs text-ink-muted"><%= t("attempts.grade.auto_score") %>: <span class="num"><%= answer.auto_score %></span></p>
  <% elsif question.matching? %>
    <% if answer.pairs.values.all?(&:blank?) %>
      <p class="text-ink-subtle italic"><%= t("attempts.grade.no_answer") %></p>
    <% else %>
      <ul class="space-y-1.5">
        <% question.left_items.each do |left| %>
          <% chosen_id = answer.pairs[left["id"]] %>
          <% chosen = question.right_items.find { |item| item["id"] == chosen_id } %>
          <% correct = question.right_items.find { |item| item["id"] == question.pairs[left["id"]] } %>
          <% ok = chosen_id.to_s == question.pairs[left["id"]].to_s %>
          <li class="flex flex-wrap items-center gap-1.5 text-ink">
            <span><%= left["text"] %></span>
            <span class="text-ink-subtle" aria-hidden="true">→</span>
            <span><%= chosen ? chosen["text"] : t("common.dash") %></span>
            <% if ok %>
              <span class="badge badge-success"><%= t("attempts.grade.pair_correct") %></span>
            <% else %>
              <span class="badge badge-neutral"><%= t("attempts.grade.pair_expected", value: correct&.fetch("text", t("common.dash"))) %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <p class="mt-2 text-xs text-ink-muted"><%= t("attempts.grade.auto_score") %>: <span class="num"><%= answer.auto_score %></span></p>
  <% else %>
    <p class="whitespace-pre-wrap text-ink"><%= answer.text_response.presence || t("common.dash") %></p>
  <% end %>
</div>
