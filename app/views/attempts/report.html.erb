<% content_for :title, t("attempts.report.title", name: @attempt.student.name) %>
<% max_score = @grade&.max_score || @exam.max_score %>
<% total_score = @grade&.total_score %>
<% percent = total_score && max_score.to_f.positive? ? (total_score / max_score * 100).round : nil %>

<div class="no-print mb-6">
  <%= render "shared/breadcrumbs", crumbs: [
        [ t("classes.index.title"), class_groups_path ],
        [ @exam.class_group.name, class_group_path(@exam.class_group) ],
        [ @exam.subject.name, subject_path(@exam.subject) ],
        [ @exam.title, test_path(@exam) ],
        [ @attempt.student.name, attempt_path(@attempt) ]
      ] %>
</div>

<article class="print-sheet">
  <header class="border-b border-line pb-4">
    <p class="text-sm text-ink-muted"><%= t("attempts.report.heading") %></p>
    <h2 class="page-title mt-0.5"><%= @exam.title %></h2>

    <dl class="mt-4 grid gap-x-8 gap-y-1.5 text-sm sm:grid-cols-2">
      <div class="flex gap-2">
        <dt class="text-ink-muted"><%= t("exams.assign.student") %></dt>
        <dd class="font-medium text-ink"><%= @attempt.student.name %></dd>
      </div>
      <div class="flex gap-2">
        <dt class="text-ink-muted"><%= t("attempts.report.class_group") %></dt>
        <dd class="text-ink"><%= @exam.class_group.name %></dd>
      </div>
      <div class="flex gap-2">
        <dt class="text-ink-muted"><%= t("attempts.report.subject") %></dt>
        <dd class="text-ink"><%= @exam.subject.name %></dd>
      </div>
      <div class="flex gap-2">
        <dt class="text-ink-muted"><%= t("attempts.report.date") %></dt>
        <dd class="text-ink"><%= l(@attempt.submitted_at || @attempt.started_at, format: :short) %></dd>
      </div>
    </dl>

    <p class="mt-4 text-sm text-ink-muted"><%= t("attempts.grade.attempt", n: @attempt.attempt_no) %></p>

    <p class="mt-3 text-base font-semibold text-ink">
      <%= t("attempts.report.total") %>:
      <span class="num">
        <%= t("attempts.report.earned", score: score_text(total_score), max: score_text(max_score)) %>
      </span>
      <% if percent %>
        <span class="num text-ink-muted"><%= t("subjects.stats.percent", value: percent) %></span>
      <% end %>
    </p>

    <% if @grade.nil? || @grade.incomplete? %>
      <p class="mt-1.5 text-xs text-ink-muted"><%= t("attempts.report.provisional") %></p>
    <% end %>
  </header>

  <ol class="mt-6 space-y-6">
    <% @questions.each_with_index do |question, index| %>
      <% answer = @answers[question.id] %>
      <li id="<%= dom_id(question, :report) %>" class="print-question">
        <div class="flex flex-wrap items-center gap-2 text-xs text-ink-muted">
          <span class="num font-semibold">№<%= index + 1 %></span>
          <span class="chip"><%= t("question_types.#{question.question_type}") %></span>
          <span class="num">
            <%= t("attempts.report.earned",
                  score: score_text(answer&.effective_score), max: score_text(question.points)) %>
          </span>
        </div>

        <% if question.source? && question.source_text.present? %>
          <div class="mt-3">
            <p class="mb-1.5 text-xs font-medium text-ink-muted"><%= t("take.source.label") %></p>
            <div class="source-text"><%= question.source_text %></div>
          </div>
        <% end %>

        <p class="mt-3 font-medium whitespace-pre-wrap text-ink"><%= question.prompt %></p>

        <%= render "shared/student_answer", question: question, answer: answer %>

        <% if answer&.teacher_comment.present? %>
          <p class="mt-3 text-xs font-medium text-ink-muted"><%= t("attempts.report.teacher_comment") %></p>
          <p class="mt-1 text-sm whitespace-pre-wrap text-ink"><%= answer.teacher_comment %></p>
        <% end %>
      </li>
    <% end %>
  </ol>

  <% if @grade&.teacher_comment.present? %>
    <section class="mt-6 border-t border-line pt-4">
      <p class="text-xs font-medium text-ink-muted"><%= t("attempts.grade.overall_comment") %></p>
      <p class="mt-1 text-sm whitespace-pre-wrap text-ink"><%= @grade.teacher_comment %></p>
    </section>
  <% end %>
</article>
