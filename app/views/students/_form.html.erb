<%= form_with model: student, class: "card card-pad max-w-md space-y-4" do |f| %>
  <%= render "shared/form_errors", record: student %>
  <div class="fieldset">
    <%= f.label :name, class: "field-label" %>
    <%= f.text_field :name, required: true, class: field_class %>
  </div>
  <div class="fieldset">
    <%= f.label :email, t("students.form.email_optional"), class: "field-label" %>
    <%= f.email_field :email, class: field_class %>
  </div>
  <div class="fieldset">
    <%= f.label :telegram_username, t("telegram.username_optional"), class: "field-label" %>
    <%= f.text_field :telegram_username, placeholder: "@username", class: field_class, autocapitalize: "none", spellcheck: false %>
    <p class="text-sm text-ink-muted"><%= t("telegram.username_hint") %></p>
  </div>
  <%= f.button(class: btn_primary) { |label| safe_join([ ui_icon("check"), label ]) } %>
<% end %>
