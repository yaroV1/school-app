<% content_for :title, @student.name %>
<% group = @student.class_groups.first %>
<div class="mb-6">
  <%= render "shared/breadcrumbs", crumbs: [
        [ t("classes.index.title"), class_groups_path ],
        (group ? [ group.name, students_class_group_path(group) ] : nil),
        [ @student.name, nil ]
      ].compact %>
  <div class="mt-3 flex flex-wrap items-start justify-between gap-3">
    <div>
      <h1 class="page-title"><%= @student.name %></h1>
      <% if @student.email.present? %><p class="page-subtitle"><%= @student.email %></p><% end %>
      <p class="mt-2"><span class="chip"><%= t("common.credits", count: @student.credit_balance) %></span></p>
    </div>
    <%= link_to t("common.edit"), edit_student_path(@student), class: btn_secondary %>
  </div>
</div>

<h2 class="section-title mb-3"><%= t("students.show.history") %></h2>
<% if @attempts.any? %>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t("attempts.history.test") %></th>
          <th><%= t("attempts.history.attempt") %></th>
          <th><%= t("attempts.history.status") %></th>
          <th><%= t("attempts.history.started") %></th>
          <th><%= t("attempts.history.score") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @attempts.each do |attempt| %>
          <tr>
            <td class="font-medium"><%= attempt.exam.title %></td>
            <td class="num">№<%= attempt.attempt_no %></td>
            <td><%= status_badge(attempt.status) %></td>
            <td class="text-ink-muted"><%= l(attempt.started_at, format: :short) %></td>
            <td class="num">
              <% if attempt.grade&.finalized_by_teacher? %>
                <%= attempt.grade.total_score %>/<%= attempt.grade.max_score %>
              <% elsif attempt.grade %>
                <%= attempt.grade.total_score || t("common.dash") %>/<%= attempt.grade.max_score %>
                <span class="text-ink-muted"><%= t("students.show.draft_score") %></span>
              <% else %>
                <%= t("common.dash") %>
              <% end %>
            </td>
            <td class="text-right"><%= link_to t("common.open"), attempt_path(attempt), class: "link" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="empty-state"><%= t("students.show.empty_history") %></p>
<% end %>

<h2 class="section-title mt-8 mb-3"><%= t("students.credits.history") %></h2>
<% if @credit_entries.any? %>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th><%= t("students.credits.test") %></th>
          <th><%= t("students.credits.date") %></th>
          <th><%= t("students.credits.change") %></th>
        </tr>
      </thead>
      <tbody>
        <% @credit_entries.each do |entry| %>
          <tr>
            <td class="font-medium"><%= entry.assignment.exam.title %></td>
            <td class="text-ink-muted"><%= l(entry.created_at, format: :short) %></td>
            <td class="num"><%= format("%+d", entry.amount) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="empty-state"><%= t("students.credits.empty") %></p>
<% end %>
