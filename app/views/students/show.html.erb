<% content_for :title, @student.name %>
<div class="mb-6 flex items-start justify-between gap-4">
  <div>
    <% if (group = @student.class_groups.first) %>
      <%= link_to group.name, class_group_path(group), class: "text-sm text-slate-600 underline" %>
    <% else %>
      <%= link_to t("classes.show.back"), class_groups_path, class: "text-sm text-slate-600 underline" %>
    <% end %>
    <h1 class="mt-2 text-2xl font-semibold"><%= @student.name %></h1>
    <% if @student.email.present? %><p class="text-slate-600"><%= @student.email %></p><% end %>
  </div>
  <%= link_to t("common.edit"), edit_student_path(@student), class: btn_secondary %>
</div>

<h2 class="mb-3 text-lg font-medium"><%= t("students.show.history") %></h2>
<% if @attempts.any? %>
  <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
    <table class="min-w-full text-sm">
      <thead class="bg-slate-50 text-left text-slate-600">
        <tr>
          <th class="px-3 py-2"><%= t("attempts.history.test") %></th>
          <th class="px-3 py-2"><%= t("attempts.history.attempt") %></th>
          <th class="px-3 py-2"><%= t("attempts.history.status") %></th>
          <th class="px-3 py-2"><%= t("attempts.history.started") %></th>
          <th class="px-3 py-2"><%= t("attempts.history.score") %></th>
          <th class="px-3 py-2"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @attempts.each do |attempt| %>
          <tr>
            <td class="px-3 py-2"><%= attempt.exam.title %></td>
            <td class="px-3 py-2">№<%= attempt.attempt_no %></td>
            <td class="px-3 py-2"><%= status_badge(attempt.status) %></td>
            <td class="px-3 py-2"><%= l(attempt.started_at, format: :short) %></td>
            <td class="px-3 py-2">
              <% if attempt.grade&.finalized_by_teacher? %>
                <%= attempt.grade.total_score %>/<%= attempt.grade.max_score %>
              <% elsif attempt.grade %>
                <%= attempt.grade.total_score || t("common.dash") %>/<%= attempt.grade.max_score %> <%= t("students.show.draft_score") %>
              <% else %>
                <%= t("common.dash") %>
              <% end %>
            </td>
            <td class="px-3 py-2 text-right"><%= link_to t("common.open"), attempt_path(attempt), class: "underline" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="text-slate-600"><%= t("students.show.empty_history") %></p>
<% end %>
