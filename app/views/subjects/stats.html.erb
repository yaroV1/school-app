<% content_for :title, @subject.name %>
<%= render "subjects/header", subject: @subject %>

<section>
  <div class="mb-4">
    <h2 class="section-title"><%= t("subjects.show.stats") %></h2>
    <p class="page-subtitle"><%= t("subjects.show.stats_hint") %></p>
  </div>

  <% if @stat_rows.any? %>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th><%= t("subjects.stats.student") %></th>
            <th><%= t("subjects.stats.tests") %></th>
            <th><%= t("subjects.stats.average") %></th>
            <th><%= t("subjects.stats.last") %></th>
          </tr>
        </thead>
        <tbody>
          <% @stat_rows.each do |row| %>
            <tr>
              <td><%= link_to row.student.name, student_path(row.student), class: "font-medium hover:text-accent" %></td>
              <td class="num">
                <% if row.assigned.positive? %>
                  <%= t("subjects.stats.progress", finished: row.finished, assigned: row.assigned) %>
                <% else %>
                  <%= t("common.dash") %>
                <% end %>
              </td>
              <td class="num">
                <% if row.average_percent %>
                  <%= t("subjects.stats.percent", value: row.average_percent) %>
                <% else %>
                  <%= t("common.dash") %>
                <% end %>
              </td>
              <td class="text-ink-muted">
                <%= row.last_activity_at ? l(row.last_activity_at, format: :short) : t("common.dash") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="empty-state">
      <%= t("subjects.show.empty_students") %>
      <%= link_to t("classes.show.add_student"), students_class_group_path(@subject.class_group), class: "link" %>
    </p>
  <% end %>
</section>
