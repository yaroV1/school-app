<div class="mb-6">
  <%= render "shared/breadcrumbs", crumbs: [
        [ t("classes.index.title"), class_groups_path ],
        [ subject.class_group.name, class_group_path(subject.class_group) ],
        [ subject.name, nil ]
      ] %>
  <div class="mt-3 flex flex-wrap items-start justify-between gap-3">
    <h1 class="page-title"><%= subject.name %></h1>
    <div class="flex flex-wrap gap-2">
      <%= link_to t("common.edit"), edit_subject_path(subject), class: btn_secondary %>
      <%= button_to t("common.delete"), subject_path(subject), method: :delete, form: { data: { turbo_confirm: t("subjects.show.delete_confirm") } }, class: btn_danger %>
    </div>
  </div>
</div>

<%= render "subjects/tabs", subject: subject %>
