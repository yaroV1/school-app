<% content_for :title, t("subjects.edit.title") %>
<div class="mb-6">
  <%= render "shared/breadcrumbs", crumbs: [
        [ t("classes.index.title"), class_groups_path ],
        [ @subject.class_group.name, class_group_path(@subject.class_group) ],
        [ @subject.name, subject_path(@subject) ],
        [ t("subjects.edit.title"), nil ]
      ] %>
  <h1 class="page-title mt-3"><%= t("subjects.edit.title") %></h1>
</div>
<%= render "form", subject: @subject %>
