<% content_for :title, @subject.name %>
<div class="mb-6">
  <%= link_to @subject.class_group.name, class_group_path(@subject.class_group), class: "text-sm text-slate-600 underline" %>
  <div class="mt-2 flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold"><%= @subject.name %></h1>
      <p class="text-sm text-slate-500"><%= @subject.class_group.name %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to t("common.edit"), edit_subject_path(@subject), class: btn_secondary %>
      <%= button_to t("common.delete"), subject_path(@subject), method: :delete, form: { data: { turbo_confirm: t("subjects.show.delete_confirm") } }, class: btn_secondary %>
    </div>
  </div>
</div>

<section class="mb-10">
  <div class="mb-3 flex items-center justify-between gap-3">
    <h2 class="text-lg font-medium"><%= t("subjects.show.tests") %></h2>
    <%= link_to t("subjects.show.new_test"), new_subject_exam_path(@subject), class: btn_primary %>
  </div>

  <% if @exams.any? %>
    <ul class="divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
      <% @exams.each do |exam| %>
        <li class="flex items-center justify-between gap-3 px-4 py-3">
          <div>
            <%= link_to exam.title, test_path(exam), class: "font-medium hover:underline" %>
            <div class="mt-1 flex items-center gap-2 text-sm text-slate-500">
              <%= status_badge(exam.status) %>
              <span><%= t("exams.questions_count", count: exam.questions.size) %></span>
            </div>
          </div>
          <%= link_to t("common.open"), test_path(exam), class: btn_secondary %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-slate-600"><%= t("subjects.show.empty_tests") %></p>
  <% end %>
</section>

<section>
  <h2 class="mb-1 text-lg font-medium"><%= t("subjects.show.stats") %></h2>
  <p class="mb-3 text-sm text-slate-500"><%= t("subjects.show.stats_hint") %></p>

  <% if @stat_rows.any? %>
    <div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
      <table class="min-w-full text-sm">
        <thead class="bg-slate-50 text-left text-slate-600">
          <tr>
            <th class="px-3 py-2"><%= t("subjects.stats.student") %></th>
            <th class="px-3 py-2"><%= t("subjects.stats.tests") %></th>
            <th class="px-3 py-2"><%= t("subjects.stats.average") %></th>
            <th class="px-3 py-2"><%= t("subjects.stats.last") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @stat_rows.each do |row| %>
            <tr>
              <td class="px-3 py-2"><%= link_to row.student.name, student_path(row.student), class: "font-medium underline" %></td>
              <td class="px-3 py-2">
                <% if row.assigned.positive? %>
                  <%= t("subjects.stats.progress", finished: row.finished, assigned: row.assigned) %>
                <% else %>
                  <%= t("common.dash") %>
                <% end %>
              </td>
              <td class="px-3 py-2">
                <% if row.average_percent %>
                  <%= t("subjects.stats.percent", value: row.average_percent) %>
                <% else %>
                  <%= t("common.dash") %>
                <% end %>
              </td>
              <td class="px-3 py-2">
                <%= row.last_activity_at ? l(row.last_activity_at, format: :short) : t("common.dash") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-slate-600"><%= t("subjects.show.empty_students") %></p>
    <%= link_to t("classes.show.add_student"), class_group_path(@subject.class_group), class: "mt-2 inline-block text-sm underline" %>
  <% end %>
</section>
