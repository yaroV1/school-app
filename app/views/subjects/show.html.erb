<% content_for :title, @subject.name %>
<%= render "subjects/header", subject: @subject %>

<section>
  <div class="mb-3 flex items-center justify-between gap-3">
    <h2 class="text-lg font-medium"><%= t("subjects.show.tests") %></h2>
    <%= link_to t("subjects.show.new_test"), new_subject_exam_path(@subject), class: btn_primary %>
  </div>

  <%= form_with url: subject_path(@subject), method: :get,
        data: { controller: "autosubmit", turbo_action: "replace" },
        class: "mb-4 flex flex-wrap items-end gap-3" do %>
    <div class="min-w-56 flex-1">
      <%= label_tag :q, t("subjects.show.search"), class: "text-sm font-medium" %>
      <%= search_field_tag :q, @query, placeholder: t("subjects.show.search_placeholder"), class: field_class %>
    </div>
    <div>
      <%= label_tag :sort, t("subjects.show.sort"), class: "text-sm font-medium" %>
      <%= select_tag :sort, options_for_select(@sort_options, @sort),
            class: field_class, data: { action: "change->autosubmit#submit" } %>
    </div>
    <%= submit_tag t("common.apply"), class: btn_secondary %>
    <% if @filtered %>
      <%= link_to t("subjects.show.clear"), subject_path(@subject), class: "pb-2 text-sm text-slate-600 underline" %>
    <% end %>
  <% end %>

  <% if @exams.any? %>
    <ul class="divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
      <% @exams.each do |exam| %>
        <li class="flex items-center justify-between gap-3 px-4 py-3">
          <div>
            <%= link_to exam.title, test_path(exam), class: "font-medium hover:underline" %>
            <div class="mt-1 flex items-center gap-2 text-sm text-slate-500">
              <%= status_badge(exam.status) %>
              <span><%= t("exams.questions_count", count: exam.questions.size) %></span>
              <span>· <%= l(exam.created_at, format: :short) %></span>
            </div>
          </div>
          <%= link_to t("common.open"), test_path(exam), class: btn_secondary %>
        </li>
      <% end %>
    </ul>
  <% elsif @query.present? %>
    <p class="text-slate-600"><%= t("subjects.show.no_matches", query: @query) %></p>
  <% else %>
    <p class="text-slate-600"><%= t("subjects.show.empty_tests") %></p>
  <% end %>
</section>
