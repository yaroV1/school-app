<span class="brand-mark <%= local_assigns[:class_name] %>" aria-hidden="true">
  <svg viewBox="0 0 32 32" fill="none">
    <%# A tablet is pillow-shaped, not rectangular: wet clay bulges when a hand presses it.
        The bulge is what separates this silhouette from a page or a card at favicon size,
        where the wedges inside have already collapsed into texture. %>
    <path d="M8 7.5c4-1.3 12-1.3 16 0 1.4 5.5 1.4 11.5 0 17-4 1.3-12 1.3-16 0-1.4-5.5-1.4-11.5 0-17Z"
          fill="currentColor" fill-opacity=".16" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
    <%# The tail is the whole point: a stylus impression is roughly twice as long as it is
        tall, and an equilateral triangle reads as a play button instead. %>
    <path d="M10.3 11 14.9 12.05 10.3 13.1ZM16.2 11 20.8 12.05 16.2 13.1ZM10.3 15.4 14.9 16.45 10.3 17.5ZM16.2 15.4 20.8 16.45 16.2 17.5Z"
          fill="currentColor" />
    <path d="M10.3 21h10.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  </svg>
</span>
