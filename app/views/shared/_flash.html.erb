<% if notice = flash[:notice] %>
  <div class="flash flash-notice" id="notice" role="status" data-controller="dismiss">
    <svg class="mt-0.5 size-4 shrink-0" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="10" cy="10" r="7.25" />
      <path d="M6.75 10.25 9 12.5l4.25-4.75" />
    </svg>
    <p class="flex-1"><%= notice %></p>
    <%= render "shared/flash_dismiss" %>
  </div>
<% end %>

<% if alert = flash[:alert] %>
  <div class="flash flash-alert" id="alert" role="alert" data-controller="dismiss">
    <svg class="mt-0.5 size-4 shrink-0" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10 3.5 2.75 16.5h14.5L10 3.5Z" />
      <path d="M10 8v3.25M10 13.75v.5" />
    </svg>
    <p class="flex-1"><%= alert %></p>
    <%= render "shared/flash_dismiss" %>
  </div>
<% end %>
