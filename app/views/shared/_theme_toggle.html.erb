<button type="button"
        class="theme-toggle"
        data-controller="theme"
        data-action="theme#toggle"
        data-theme-light-color-value="#f3eee4"
        data-theme-dark-color-value="#2a2620"
        aria-label="<%= t("nav.toggle_theme") %>">
  <svg class="theme-icon-moon size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12.5 3.4A6.6 6.6 0 1 0 16.6 12 5.2 5.2 0 0 1 12.5 3.4Z" />
  </svg>
  <svg class="theme-icon-sun size-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="10" cy="10" r="3.25" />
    <path d="M10 2.75v1.5M10 15.75v1.5M2.75 10h1.5M15.75 10h1.5M4.7 4.7l1.06 1.06M14.24 14.24l1.06 1.06M4.7 15.3l1.06-1.06M14.24 5.76l1.06-1.06" />
  </svg>
</button>
