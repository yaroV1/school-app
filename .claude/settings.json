{
  "permissions": {
    "allow": [
      "Bash(bin/ci)",
      "Bash(bin/rails test)",
      "Bash(bin/rails test:*)",
      "Bash(bin/rubocop)",
      "Bash(bin/rubocop:*)",
      "Bash(bin/brakeman)",
      "Bash(bin/brakeman:*)",
      "Bash(bin/bundler-audit)",
      "Bash(bin/bundler-audit:*)",
      "Bash(bin/importmap audit)",
      "Bash(bin/rails db:migrate)",
      "Bash(bin/rails db:migrate:status)",
      "Bash(bin/rails db:test:prepare)",
      "Bash(bin/rails db:seed)",
      "Bash(bin/rails routes:*)",
      "Bash(bundle list:*)",
      "Bash(bundle info:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git add:*)",
      "Bash(git mv prd/:*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -v)",
      "Bash(git branch --list:*)",
      "Bash(git remote -v)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(bin/kamal:*)",
      "Bash(bin/rails runner:*)",
      "Bash(bin/rails db:drop:*)",
      "Bash(bin/rails db:reset:*)",
      "Bash(bin/rails db:schema:load:*)",
      "Bash(bin/rails db:migrate:reset:*)",
      "Bash(bin/rails db:seed:replant:*)"
    ],
    "deny": [
      "Read(./config/*.key)",
      "Read(./config/credentials.yml.enc)",
      "Read(./config/credentials/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.kamal/secrets)",
      "Read(./.kamal/secrets.*)",
      "Read(./storage/**)",
      "Read(./tmp/storage/**)",
      "Read(./log/**)",
      "Edit(./config/*.key)",
      "Edit(./config/credentials.yml.enc)",
      "Edit(./config/credentials/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./.kamal/secrets)",
      "Edit(./.kamal/secrets.*)",
      "Edit(./storage/**)",
      "Edit(./tmp/storage/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.claude/hooks/**)",
      "Write(./config/*.key)",
      "Write(./config/credentials.yml.enc)",
      "Write(./config/credentials/**)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./.kamal/secrets)",
      "Write(./.kamal/secrets.*)",
      "Write(./storage/**)",
      "Write(./tmp/storage/**)",
      "Write(./.claude/settings.json)",
      "Write(./.claude/settings.local.json)",
      "Write(./.claude/hooks/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git commit --amend:*)",
      "Bash(git reset --hard:*)",
      "Bash(git config:*)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git add .)",
      "Bash(git stash:*)",
      "Bash(git clean:*)",
      "Bash(git restore:*)",
      "Bash(git checkout -- :*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ruby \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.rb\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
