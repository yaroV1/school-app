# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

# Some global gitignores exclude /AGENTS.md (local Codex/agent files).
# This contract must stay trackable: git add -f AGENTS.md
!/AGENTS.md

# Personal Claude Code overrides. .claude/settings.json is shared and tracked.
/.claude/settings.local.json


/app/assets/builds/*
!/app/assets/builds/.keep

# /implement-prd build logs. progress.md records one run — reviewer findings, probes,
# what was fixed — and stops being useful once the PRD is merged. project.md stays
# tracked: it is the spec, and its Affected Areas list is the scope rail the skill
# enforces against the diff.
/prd/**/progress.md
